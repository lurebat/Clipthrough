<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Clipthrough.ViewModels"
        x:Class="Clipthrough.Views.SessionLogsWindow"
        x:DataType="vm:SessionLogsViewModel"
        x:CompileBindings="True"
        Title="{Binding TitleText}"
        Width="1080"
        Height="680"
        MinWidth="420"
        MinHeight="320"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="10"
          Margin="12">

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Classes="body-muted"
                       TextWrapping="Wrap"
                       Text="{Binding DescriptionText}" />
            <TextBlock Classes="body-muted"
                       Text="{Binding CountText}" />
        </StackPanel>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="10">
            <TextBox MaxWidth="420"
                     HorizontalAlignment="Stretch"
                     AutomationProperties.Name="Search logs"
                     PlaceholderText="{Binding SearchWatermark}"
                     Text="{Binding SearchText}" />
            <ComboBox Grid.Column="1"
                      Width="160"
                      AutomationProperties.Name="Log level filter"
                      ItemsSource="{Binding LogLevelOptions}"
                      SelectedItem="{Binding SelectedLogLevelOption}" />
            <Button Grid.Column="2"
                    Classes="secondary compact"
                    Content="📋 Copy All"
                    Click="OnCopyAllLogsClick" />
        </Grid>

        <Border Grid.Row="2"
                Classes="inset-panel"
                Padding="0">
            <Grid>
                <TextBlock Classes="empty-state"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding ShowEmptyState}"
                           Text="{Binding EmptyMessage}" />

                <DataGrid x:Name="SessionLogsDataGrid"
                          ItemsSource="{Binding VisibleSessionLogs}"
                          IsVisible="{Binding HasLogs}"
                          IsReadOnly="True"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding DateText}"
                                            Width="110" />
                        <DataGridTextColumn Header="Time"
                                            Binding="{Binding TimestampText}"
                                            Width="90" />
                        <DataGridTemplateColumn Header="Level" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:SessionLogEntryViewModel">
                                    <Border Background="{Binding LevelBackground}"
                                            BorderBrush="{Binding LevelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            Margin="4,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LevelText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Message"
                                            Binding="{Binding Message}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
