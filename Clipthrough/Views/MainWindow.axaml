<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Clipthrough.Controls"
        xmlns:vm="using:Clipthrough.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1360"
        d:DesignHeight="860"
        x:Class="Clipthrough.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1360"
        Height="860"
        MinWidth="1080"
        MinHeight="700">

    <Grid RowDefinitions="Auto,*,Auto"
          RowSpacing="10"
          Margin="10">
        <Border Grid.Row="0"
                Classes="hero-toolbar"
                Padding="12,10">
            <Grid ColumnDefinitions="Auto,*,160,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="10">
                <TextBlock Classes="window-title"
                           VerticalAlignment="Center"
                           Text="{Binding HeroTitle}" />

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Watermark="{Binding SearchWatermark}"
                         Text="{Binding SearchText}" />

                <ComboBox Grid.Column="2"
                          Classes="compact-field"
                          ItemsSource="{Binding ContentTypeOptions}"
                          SelectedItem="{Binding SelectedContentTypeOption}" />

                <CheckBox Grid.Column="3"
                          Classes="filter-toggle compact-toggle"
                          IsChecked="{Binding ShowFavoritesOnly}"
                          Content="{Binding FavoritesFilterLabel}" />

                <CheckBox Grid.Column="4"
                          Classes="filter-toggle compact-toggle"
                          IsChecked="{Binding ShowSensitiveOnly}"
                          Content="{Binding SensitiveFilterLabel}" />

                <CheckBox Grid.Column="5"
                          Classes="filter-toggle compact-toggle"
                          IsChecked="{Binding UseRegexSearch}"
                          Content="{Binding RegexFilterLabel}" />

                <CheckBox Grid.Column="6"
                          Classes="filter-toggle compact-toggle"
                          IsChecked="{Binding CaseSensitiveSearch}"
                          Content="{Binding CaseSensitiveFilterLabel}" />

                <Button Grid.Column="7"
                        Classes="secondary compact"
                        Command="{Binding RefreshCommand}"
                        Content="{Binding RefreshButtonLabel}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="380,6,*"
              ColumnSpacing="10">
            <Border Grid.Column="0"
                    Classes="surface-panel">
                <Grid RowDefinitions="Auto,*,Auto"
                      RowSpacing="10"
                      Margin="12">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*"
                          ColumnSpacing="8">
                        <Button Classes="secondary compact"
                                Command="{Binding SelectAllClipsCommand}"
                                Content="{Binding SelectAllButtonLabel}" />
                        <Button Classes="secondary compact"
                                Grid.Column="1"
                                Command="{Binding SelectNoClipsCommand}"
                                Content="{Binding SelectNoneButtonLabel}" />
                        <Button Classes="secondary compact"
                                Grid.Column="2"
                                Command="{Binding FavoriteCheckedClipsCommand}"
                                IsEnabled="{Binding HasCheckedClips}"
                                Content="{Binding FavoriteSelectedButtonLabel}" />
                        <Button Classes="destructive compact"
                                Grid.Column="3"
                                Command="{Binding DeleteCheckedClipsCommand}"
                                IsEnabled="{Binding HasCheckedClips}"
                                Content="{Binding DeleteButtonLabel}" />
                        <TextBlock Classes="body-muted"
                                   Grid.Column="4"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Text="{Binding CheckedClipSummaryText}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <TextBlock Classes="empty-state"
                                    IsVisible="{Binding HasNoClips}"
                                    HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding EmptyListMessage}" />

                        <ListBox x:Name="ClipsListBox"
                                  Classes="clip-list"
                                  ItemsSource="{Binding Clips}"
                                  SelectedItem="{Binding SelectedClip, Mode=TwoWay}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ClipItemViewModel">
                                    <Border Classes="clip-row-card"
                                            Background="{Binding FrequencyBackground}"
                                            BorderBrush="{Binding RowBorderBrush}"
                                            BorderThickness="{Binding RowBorderThickness}"
                                            Padding="10,8">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding CopyLabel}"
                                                          Command="{Binding CopyCommand}" />
                                                <MenuItem Header="{Binding FavoriteActionLabel}"
                                                          Command="{Binding ToggleFavoriteCommand}" />
                                                <MenuItem Header="{Binding DeleteLabel}"
                                                          Command="{Binding DeleteCommand}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                              ColumnSpacing="10">
                                            <CheckBox Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />

                                            <Border Grid.Column="1"
                                                    Classes="clip-row-icon"
                                                    VerticalAlignment="Center">
                                                <Grid>
                                                    <Image Source="{Binding SourceAppIconImage}"
                                                           Width="18"
                                                           Height="18"
                                                           Stretch="Uniform"
                                                           IsVisible="{Binding HasSourceAppIcon}" />
                                                    <TextBlock Text="{Binding TypeGlyph}"
                                                               Foreground="{Binding StateAccentBrush}"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding ShowTypeGlyph}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                <Image Source="{Binding PreviewThumbnailImage}"
                                                       Width="84"
                                                       Height="48"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding ShowPreviewThumbnail}" />
                                                <TextBlock Classes="clip-row-preview"
                                                           Text="{Binding SingleLinePreview}"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding ShowTextPreview}" />
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="6">
                                                    <TextBlock Classes="clip-row-date"
                                                               Text="{Binding FirstCopiedAtDisplay}"
                                                               FontSize="10" />
                                                    <TextBlock Classes="clip-row-date"
                                                               Text="{Binding CopyCountCompact}"
                                                               IsVisible="{Binding ShowCopyCountBadge}"
                                                               FontSize="10" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FavoriteMarker}"
                                                           Foreground="{Binding StateAccentBrush}"
                                                           IsVisible="{Binding IsFavorite}" />
                                                <TextBlock Classes="clip-row-date"
                                                           Text="{Binding CapturedAtCompact}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.Row="2"
                            Classes="inset-panel"
                            Padding="10,8">
                        <TextBlock Classes="body-muted"
                                   VerticalAlignment="Center"
                                   Text="{Binding ClipboardStateText}" />
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Width="6" />

            <Border Grid.Column="2"
                    Classes="surface-panel"
                    BorderBrush="{Binding SelectedClipAreaBorderBrush}"
                    BorderThickness="{Binding SelectedClipAreaBorderThickness}">
                <Grid RowDefinitions="Auto,*,Auto"
                      RowSpacing="10"
                      Margin="14">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="panel-caption"
                                       Text="{Binding SelectedClipContentTypeText}" />
                            <TextBlock Classes="panel-title"
                                       Foreground="{Binding SelectedClipAccentBrush}"
                                       Text="{Binding SelectedClipTitleText}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="body-muted"
                                       Text="{Binding SelectionStateTitle}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <Border Classes="badge-chip"
                                        IsVisible="{Binding ShowSelectedClipSeverityIndicator}"
                                        Background="{Binding SelectedClipSeverityBadgeBackground}"
                                        BorderBrush="{Binding SelectedClipSeverityBadgeBorderBrush}">
                                    <TextBlock Text="{Binding SelectedClipSeverityIndicatorText}"
                                               Foreground="{Binding SelectedClipSeverityBadgeForeground}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="12"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBlock Classes="body-muted"
                                           VerticalAlignment="Center"
                                           Text="{Binding RawToggleLabel}" />
                                <ToggleSwitch IsChecked="{Binding ShowRawContent}"
                                              IsEnabled="{Binding HasSelectedClip}"
                                              VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Classes="secondary compact"
                                    Command="{Binding CopySelectedCommand}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    Content="{Binding CopyButtonLabel}" />

                            <Button Classes="secondary compact"
                                    Command="{Binding CopyEditedClipCommand}"
                                    IsVisible="{Binding ShowCopyEditedClipButton}"
                                    Content="{Binding CopyAsNewButtonLabel}" />

                            <Button Classes="secondary compact favorite-toggle"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    Classes.active="{Binding IsSelectedClipFavorite}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    Content="{Binding FavoriteButtonLabel}" />

                            <Button Classes="destructive compact"
                                    Command="{Binding DeleteSelectedCommand}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    Content="{Binding DeleteButtonLabel}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Classes="content-stage"
                            BorderBrush="{Binding SelectedClipAreaBorderBrush}"
                            BorderThickness="{Binding SelectedClipAreaBorderThickness}"
                            Padding="0">
                        <Grid>
                            <StackPanel IsVisible="{Binding ShowEmptySelectionState}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10"
                                        MaxWidth="420">
                                <TextBlock Text="📋"
                                           FontSize="44"
                                           HorizontalAlignment="Center" />
                                <TextBlock Classes="panel-title"
                                           HorizontalAlignment="Center"
                                           Text="{Binding EmptySelectionTitleText}" />
                                <TextBlock Classes="body-muted"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="{Binding EmptySelectionDescriptionText}" />
                            </StackPanel>

                            <TextBox IsVisible="{Binding ShowRawTextContent}"
                                      Classes="content-viewer raw-content-viewer"
                                      IsReadOnly="{Binding SelectedClipTextIsReadOnly}"
                                      AcceptsReturn="True"
                                      HorizontalContentAlignment="Stretch"
                                      Text="{Binding EditedClipText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox IsVisible="{Binding ShowSelectedTextRenderer}"
                                      Classes="content-viewer"
                                      IsReadOnly="{Binding SelectedClipTextIsReadOnly}"
                                      AcceptsReturn="True"
                                      HorizontalContentAlignment="Stretch"
                                      Text="{Binding EditedClipText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <controls:RichContentView IsVisible="{Binding ShowSelectedRichTextRenderer}"
                                                      Markup="{Binding SelectedClipRawContent}"
                                                      ContentFormat="{Binding SelectedClipContentFormat}" />

                            <Grid IsVisible="{Binding ShowSelectedFilesRenderer}"
                                  Margin="14">
                                <Grid RowDefinitions="Auto,*"
                                      RowSpacing="12">
                                    <TextBlock Classes="body-muted"
                                               Text="{Binding SelectedClipRenderedText}" />

                                    <ListBox Grid.Row="1"
                                             Classes="file-list"
                                             ItemsSource="{Binding SelectedClipFiles}"
                                             SelectedItem="{Binding SelectedFileItem, Mode=TwoWay}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ClipFileItemViewModel">
                                                <Border Classes="file-item-row"
                                                        Margin="0,0,0,8"
                                                        Padding="12,10">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                                          ColumnSpacing="10">
                                                        <TextBlock Text="📄"
                                                                   VerticalAlignment="Center" />

                                                        <TextBox Grid.Column="1"
                                                                 Classes="file-path-box"
                                                                 IsReadOnly="True"
                                                                 Text="{Binding FilePath}" />

                                                        <TextBlock Grid.Column="2"
                                                                   Classes="body-muted"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding AvailabilityText}" />

                                                        <Button Grid.Column="3"
                                                                Classes="secondary compact"
                                                                Command="{Binding CopyPathCommand}"
                                                                Content="{Binding CopyLabel}" />

                                                        <StackPanel Grid.Column="4"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8">
                                                            <Button Classes="secondary compact"
                                                                    Command="{Binding OpenCommand}"
                                                                    IsEnabled="{Binding Exists}"
                                                                    Content="{Binding OpenLabel}" />
                                                            <Button Classes="secondary compact"
                                                                    Command="{Binding OpenContainingFolderCommand}"
                                                                    IsEnabled="{Binding Exists}"
                                                                    Content="{Binding FolderLabel}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>

                            <TextBox IsVisible="{Binding ShowSelectedFilesFallback}"
                                     Classes="content-viewer"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     HorizontalContentAlignment="Stretch"
                                     Text="{Binding SelectedClipRawContent}" />

                            <Grid IsVisible="{Binding ShowSelectedImageRenderer}"
                                  Margin="14">
                                <Border Classes="image-placeholder"
                                        IsVisible="{Binding ShowSelectedImagePlaceholder}">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="10"
                                                MaxWidth="420">
                                        <TextBlock Text="🖼"
                                                   FontSize="48"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Classes="panel-title"
                                                   HorizontalAlignment="Center"
                                                   Text="{Binding SelectedImageTypeText}" />
                                        <TextBlock Classes="body-muted"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding SelectedClipImageHint}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel IsVisible="{Binding ShowSelectedImagePreview}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="10">
                                    <Border Classes="image-stage"
                                            Padding="12">
                                        <Image Source="{Binding SelectedClipImagePreview}"
                                               MaxWidth="320"
                                               MaxHeight="220"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Classes="body-muted"
                                               HorizontalAlignment="Center"
                                               Text="{Binding SelectedClipImageResolutionText}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="1.2*,1.0*,1.0*,0.7*,0.7*,0.9*,1.3*"
                          ColumnSpacing="10">
                        <Border Classes="detail-stat-card"
                                Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="detail-label"
                                           Text="{Binding AppLabelText}" />
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8">
                                    <Image Source="{Binding SelectedClipSourceAppIcon}"
                                            Width="18"
                                            Height="18"
                                            Stretch="Uniform"
                                            IsVisible="{Binding ShowSelectedClipSourceAppIcon}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="detail-value"
                                                Text="{Binding SelectedClipSourceText}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Classes="detail-stat-card"
                                Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="detail-label"
                                           Text="{Binding FirstCopiedLabelText}" />
                                <TextBlock Classes="detail-value"
                                           Text="{Binding SelectedClipFirstCopiedAtText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Classes="detail-stat-card"
                                Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="detail-label"
                                           Text="{Binding CapturedLabelText}" />
                                <TextBlock Classes="detail-value"
                                           Text="{Binding SelectedClipCapturedAtText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3"
                                Classes="detail-stat-card"
                                Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="detail-label"
                                           Text="{Binding CopiesLabelText}" />
                                <TextBlock Classes="detail-value"
                                           Text="{Binding SelectedClipCopyCountText}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4"
                                Classes="detail-stat-card"
                                Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="detail-label"
                                           Text="{Binding SizeLabelText}" />
                                <TextBlock Classes="detail-value"
                                           Text="{Binding SelectedClipByteSizeText}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="5"
                                Classes="detail-stat-card"
                                Padding="12,10">
                            <Border.IsVisible>
                                <Binding Path="ShowSelectedImageResolutionCard" />
                            </Border.IsVisible>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="detail-label"
                                           Text="{Binding ResolutionLabelText}" />
                                <TextBlock Classes="detail-value"
                                           Text="{Binding SelectedClipImageResolutionText}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6"
                                Classes="detail-stat-card"
                                Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="detail-label"
                                           Text="{Binding SensitivityLabelText}" />
                                <TextBlock Classes="detail-value"
                                           Text="{Binding SelectedClipSensitivityText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Classes="inset-panel footer-panel"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                  ColumnSpacing="14">
                <TextBlock Classes="body-muted"
                           Text="{Binding ActiveFilterSummary}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Classes="footer-metric"
                           Text="{Binding MatchingClipCountText}" />
                <TextBlock Grid.Column="2"
                           Classes="footer-metric"
                           Text="{Binding SensitiveClipCountText}" />
                <TextBlock Grid.Column="3"
                           Classes="body-muted"
                           Text="{Binding LastCaptureSummary}" />
                <Button Grid.Column="4"
                        Classes="secondary compact"
                        Command="{Binding OpenSettingsCommand}"
                        Content="{Binding SettingsButtonLabel}" />
            </Grid>
        </Border>

        <Border Grid.RowSpan="3"
                Classes="settings-backdrop"
                IsVisible="{Binding IsSettingsOpen}">
            <Border Classes="surface-panel settings-sheet"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     MaxWidth="980"
                     Padding="18">
                <Grid RowDefinitions="Auto,Auto,*,Auto"
                      RowSpacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="panel-title"
                                   Text="{Binding SettingsTitleText}" />
                        <TextBlock Classes="body-muted"
                                   Text="{Binding SettingsDescriptionText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Classes="body-muted"
                               Text="{Binding SettingsHintText}"
                               TextWrapping="Wrap" />

                    <Grid Grid.Row="2"
                          ColumnDefinitions="*,*,*"
                          ColumnSpacing="18">
                        <Border Classes="inset-panel"
                                Padding="14">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="panel-caption"
                                           Text="{Binding SettingsLocalHotkeysTitle}" />

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="detail-label"
                                               Text="{Binding SettingsRegexHotkeyLabel}" />
                                     <TextBox Text="{Binding SettingsToggleRegexHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="detail-label"
                                               Text="{Binding SettingsFavoritesHotkeyLabel}" />
                                     <TextBox Text="{Binding SettingsToggleFavoritesHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="detail-label"
                                               Text="{Binding SettingsSensitiveHotkeyLabel}" />
                                     <TextBox Text="{Binding SettingsToggleSensitiveHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="detail-label"
                                               Text="{Binding SettingsCaseSensitiveHotkeyLabel}" />
                                     <TextBox Text="{Binding SettingsToggleCaseSensitiveHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Classes="inset-panel"
                                Padding="14">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="panel-caption"
                                           Text="{Binding SettingsGlobalHotkeyTitle}" />

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="detail-label"
                                               Text="{Binding SettingsToggleWindowHotkeyLabel}" />
                                     <TextBox Text="{Binding SettingsToggleWindowHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="detail-label"
                                               Text="{Binding SettingsClipLimitLabel}" />
                                     <TextBox Text="{Binding SettingsMaxClipSizeKilobytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Classes="inset-panel"
                                Padding="14">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="panel-caption"
                                           Text="{Binding SettingsStorageTitle}" />

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="detail-label"
                                               Text="{Binding SettingsDatabasePathLabel}" />
                                    <TextBox Text="{Binding SettingsDatabasePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="detail-label"
                                               Text="{Binding SettingsDatabasePasswordLabel}" />
                                    <TextBox Text="{Binding SettingsDatabasePassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <TextBlock Classes="body-muted"
                                           Text="{Binding SettingsStorageHintText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right">
                        <Button Classes="secondary compact"
                                Command="{Binding CloseSettingsCommand}"
                                Content="{Binding SettingsCancelButtonLabel}" />
                        <Button Classes="primary compact"
                                Command="{Binding SaveSettingsCommand}"
                                Content="{Binding SettingsSaveButtonLabel}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
