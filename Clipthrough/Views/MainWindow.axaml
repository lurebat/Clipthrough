<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Clipthrough.Controls"
        xmlns:conv="using:Clipthrough.Converters"
        xmlns:loc="using:Clipthrough.Localization"
        xmlns:models="using:Clipthrough.Models"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        xmlns:vm="using:Clipthrough.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1360"
        d:DesignHeight="860"
        x:Class="Clipthrough.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1360"
        Height="860"
        MinWidth="1100"
        MinHeight="640">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+I" Command="{Binding OpenAiPromptCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Gesture="Ctrl+Home" Command="{Binding JumpToTopCommand}" />
    </Window.KeyBindings>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*,Auto"
              RowSpacing="6"
              Margin="8">
        <Menu Grid.Row="0" x:Name="TopMenu">
            <MenuItem Header="File">
                <MenuItem Header="_Settings…"
                          Command="{Binding OpenSettingsCommand}"
                          InputGesture="Ctrl+," />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitApplicationCommand}" />
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="_Copy selected"
                          Command="{Binding CopySelectedCommand}"
                          InputGesture="Ctrl+D" />
                <MenuItem Header="_Delete selected"
                          Command="{Binding DeleteSelectedCommand}"
                          InputGesture="Delete" />
                <Separator />
                <MenuItem Header="Toggle _favorite"
                          Command="{Binding ToggleFavoriteCommand}"
                          InputGesture="F" />
                <MenuItem Header="Toggle _pin"
                          Command="{Binding TogglePinCommand}"
                          InputGesture="P" />
                <Separator />
                <MenuItem Header="_Transform"
                          x:Name="EditTransformMenu"
                          IsEnabled="{Binding HasTransformableTarget}" />
                <Separator />
                <MenuItem Header="Extract text from image (_OCR)"
                          Command="{Binding RunOcrOnSelectedImageCommand}"
                          IsEnabled="{Binding CanRunOcr}" />
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Show session _logs" Command="{Binding SessionLogs.OpenCommand}" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="_User guide" Command="{Binding OpenHelpCommand}" />
                <MenuItem Header="{x:Static loc:AppText.CheckForUpdateMenuHeader}"
                          Command="{Binding Update.CheckForUpdateCommand}" />
                <Separator />
                <MenuItem Header="Open _logs folder" Command="{Binding Maintenance.OpenLogsFolderCommand}" />
                <MenuItem Header="Open _database folder" Command="{Binding Maintenance.OpenDatabaseFolderCommand}" />
                <Separator />
                <MenuItem Header="_About" Command="{Binding OpenAboutCommand}" />
            </MenuItem>
        </Menu>
        <Border Grid.Row="1"
                Classes="hero-toolbar"
                Padding="12,8">
            <Grid RowDefinitions="Auto,Auto"
                  RowSpacing="6">
            <Grid ColumnDefinitions="Auto,*,*"
                  ColumnSpacing="10">
                <TextBlock Classes="window-title"
                           VerticalAlignment="Center"
                           Text="{Binding HeroTitle}" />

                <Grid Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      MinWidth="360">
                    <TextBox x:Name="SearchTextBox"
                             AutomationProperties.Name="Search clips"
                             PlaceholderText="{Binding SearchWatermark}"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <primitives:Popup IsOpen="{Binding IsSearchSuggestionsOpen}"
                                      PlacementTarget="{Binding #SearchTextBox}"
                                      Placement="Bottom"
                                      Width="{Binding Bounds.Width, ElementName=SearchTextBox}">
                        <Border Classes="inset-panel"
                                Padding="4"
                                MaxHeight="220">
                            <ListBox x:Name="SearchSuggestionsList"
                                     ItemsSource="{Binding FilteredRecentSearches}"
                                     SelectionChanged="OnSearchSuggestionSelected" />
                        </Border>
                    </primitives:Popup>
                </Grid>

                <UniformGrid Grid.Column="2"
                             Columns="5"
                             HorizontalAlignment="Stretch">
                    <ToggleButton Classes="segmented-left"
                                  IsChecked="{Binding IsAllTypeSelected}"
                                  HorizontalContentAlignment="Center"
                                  Content="All" />
                    <ToggleButton Classes="segmented-center"
                                  IsChecked="{Binding IsTextTypeSelected}"
                                  HorizontalContentAlignment="Center"
                                  Content="Text" />
                    <ToggleButton Classes="segmented-center"
                                  IsChecked="{Binding IsImageTypeSelected}"
                                  HorizontalContentAlignment="Center"
                                  Content="Image" />
                    <ToggleButton Classes="segmented-center"
                                  IsChecked="{Binding IsRichTextTypeSelected}"
                                  HorizontalContentAlignment="Center"
                                  Content="Rich" />
                    <ToggleButton Classes="segmented-right"
                                  IsChecked="{Binding IsFilesTypeSelected}"
                                  HorizontalContentAlignment="Center"
                                  Content="Files" />
                </UniformGrid>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="12">
                <!-- Category filters: which clips to show -->
                <WrapPanel Grid.Column="0"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           ItemSpacing="8"
                           LineSpacing="4"
                           ToolTip.Tip="Category filters — which clips to show">
                    <CheckBox Classes="filter-toggle compact-toggle"
                              IsChecked="{Binding ShowFavoritesOnly}"
                              ToolTip.Tip="{Binding FavoritesFilterTooltip}"
                              Content="{Binding FavoritesFilterLabel}" />
                    <CheckBox Classes="filter-toggle compact-toggle"
                              IsChecked="{Binding ShowSensitiveOnly}"
                              ToolTip.Tip="{Binding SensitiveFilterTooltip}"
                              Content="{Binding SensitiveFilterLabel}" />
                    <CheckBox Classes="filter-toggle compact-toggle"
                              IsChecked="{Binding ShowPastedOnly}"
                              ToolTip.Tip="{Binding PastedFilterTooltip}"
                              Content="{Binding PastedFilterLabel}" />
                </WrapPanel>

                <Border Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Width="1"
                        Margin="4,2"
                        Background="{DynamicResource SystemBaseLowColor}"
                        Opacity="0.4" />

                <ComboBox x:Name="SortComboBox"
                          Grid.Column="2"
                          Classes="compact"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSortOption}"
                          MinWidth="120"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Sort order" />

                <!-- Search modifier filters: how the search works -->
                <WrapPanel Grid.Column="4"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           ItemSpacing="8"
                           LineSpacing="4"
                           ToolTip.Tip="Search modifiers — how the filter text is matched">
                    <CheckBox Classes="filter-toggle compact-toggle"
                              IsChecked="{Binding UseRegexSearch}"
                              ToolTip.Tip="{Binding RegexFilterTooltip}"
                              Content="{Binding RegexFilterLabel}" />
                    <CheckBox Classes="filter-toggle compact-toggle"
                              IsChecked="{Binding CaseSensitiveSearch}"
                              ToolTip.Tip="{Binding CaseSensitiveFilterTooltip}"
                              Content="{Binding CaseSensitiveFilterLabel}" />
                    <CheckBox Classes="filter-toggle compact-toggle"
                              IsChecked="{Binding UseWildcardSearch}"
                              ToolTip.Tip="{Binding WildcardFilterTooltip}"
                              Content="{Binding WildcardFilterLabel}" />
                    <CheckBox Classes="filter-toggle compact-toggle"
                              IsChecked="{Binding WholeWordSearch}"
                              ToolTip.Tip="{Binding WholeWordFilterTooltip}"
                              Content="{Binding WholeWordFilterLabel}" />
                    <CheckBox Classes="filter-toggle compact-toggle"
                              IsChecked="{Binding UseFuzzyClipSearch}"
                              ToolTip.Tip="{Binding FuzzyFilterTooltip}"
                              Content="Fuzzy" />
                    <CheckBox Classes="filter-toggle compact-toggle"
                              IsChecked="{Binding UseSemanticClipSearch}"
                              IsEnabled="{Binding IsSemanticSearchEnabled}"
                              ToolTip.Tip="{Binding SemanticFilterTooltip}"
                              Content="Semantic" />
                </WrapPanel>
            </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,6,2*"
              ColumnSpacing="4">
            <Border Grid.Column="0"
                    Classes="surface-panel"
                    MinWidth="340">
                <Grid RowDefinitions="Auto,*,Auto,Auto"
                      RowSpacing="10"
                      Margin="12">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto"
                          ColumnSpacing="4"
                          HorizontalAlignment="Stretch">
                        <Button Classes="secondary compact"
                                VerticalAlignment="Center"
                                Command="{Binding SelectAllClipsCommand}"
                                Content="{Binding SelectAllButtonLabel}" />
                        <Button Classes="secondary compact"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Command="{Binding SelectNoClipsCommand}"
                                Content="{Binding SelectNoneButtonLabel}" />
                        <Button Classes="secondary compact"
                                 Grid.Column="2"
                                VerticalAlignment="Center"
                                Command="{Binding FavoriteCheckedClipsCommand}"
                                IsEnabled="{Binding HasCheckedOrSelectedClip}"
                                Content="{Binding FavoriteSelectedButtonLabel}" />
                        <Button Classes="secondary compact"
                                 Grid.Column="3"
                                VerticalAlignment="Center"
                                Command="{Binding PinCheckedClipsCommand}"
                                IsEnabled="{Binding HasCheckedOrSelectedClip}"
                                ToolTip.Tip="Pin checked/selected clips to the top"
                                Content="📌 Pin" />
                        <Button Classes="destructive compact"
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Command="{Binding DeleteCheckedClipsCommand}"
                                IsEnabled="{Binding HasCheckedOrSelectedClip}"
                                Content="{Binding DeleteButtonLabel}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <TextBlock Classes="empty-state"
                                    IsVisible="{Binding HasNoClips}"
                                    HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding EmptyListMessage}" />

                        <ListBox x:Name="ClipsListBox"
                                  Classes="clip-list"
                                  AutomationProperties.Name="Clipboard history"
                                  ItemsSource="{Binding Clips}"
                                  SelectedItem="{Binding SelectedClip, Mode=TwoWay}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ContextMenu>
                                <!--
                                    Single shared context menu for the clip list. Bound to
                                    SelectedClip so the same menu instance can serve every
                                    row without paying the per-row template cost (~50 MenuItems
                                    × every realized container would otherwise freeze the UI
                                    when the list is rebuilt).
                                -->
                                <ContextMenu DataContext="{Binding SelectedClip}">
                                    <MenuItem Header="{Binding CopyLabel}"
                                              Command="{Binding CopyCommand}" />
                                    <MenuItem Header="Open in editor"
                                              Command="{Binding #ClipsListBox.DataContext.OpenInEditorCommand}" />
                                    <MenuItem Header="Compare checked clips"
                                              Command="{Binding #ClipsListBox.DataContext.CompareClipsCommand}" />
                                    <Separator />
                                    <MenuItem Header="{Binding FavoriteActionLabel}"
                                              Command="{Binding ToggleFavoriteCommand}" />
                                    <MenuItem Header="{Binding PinActionLabel}"
                                              Command="{Binding TogglePinCommand}" />
                                    <MenuItem Header="{Binding ExportLabel}"
                                              Command="{Binding ExportCommand}" />
                                    <MenuItem Header="Transform"
                                              IsVisible="{Binding CanAiTransform}">
                                        <MenuItem Header="Case"
                                                  IsVisible="{Binding CanTransform}">
                                            <MenuItem Header="UPPERCASE"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.UpperCase}" />
                                            <MenuItem Header="lowercase"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.LowerCase}" />
                                            <MenuItem Header="Title Case"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.TitleCase}" />
                                            <MenuItem Header="Sentence case"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.SentenceCase}" />
                                            <MenuItem Header="UpperCamelCase"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.UpperCamelCase}" />
                                            <MenuItem Header="lowerCamelCase"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.LowerCamelCase}" />
                                            <MenuItem Header="From camelCase"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.FromCamelCase}" />
                                        </MenuItem>
                                        <MenuItem Header="Whitespace"
                                                  IsVisible="{Binding CanTransform}">
                                            <MenuItem Header="Trim whitespace"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.TrimWhitespace}" />
                                            <MenuItem Header="Collapse whitespace"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.CollapseWhitespace}" />
                                            <MenuItem Header="Tabs → Spaces"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.TabsToSpaces}" />
                                            <MenuItem Header="Spaces → Tabs"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.SpacesToTabs}" />
                                        </MenuItem>
                                        <MenuItem Header="Lines"
                                                  IsVisible="{Binding CanTransform}">
                                            <MenuItem Header="Normalize line endings"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.NormalizeEol}" />
                                            <MenuItem Header="Sort lines"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.SortLines}" />
                                            <MenuItem Header="Reverse lines"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.ReverseLines}" />
                                            <MenuItem Header="Remove empty lines"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.RemoveEmptyLines}" />
                                            <MenuItem Header="Remove duplicate lines"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.RemoveDuplicateLines}" />
                                        </MenuItem>
                                        <MenuItem Header="JSON"
                                                  IsVisible="{Binding CanTransform}">
                                            <MenuItem Header="JSON quote"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.JsonQuote}" />
                                            <MenuItem Header="JSON unquote"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.JsonUnquote}" />
                                            <MenuItem Header="JSON minify"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.JsonMinify}" />
                                            <MenuItem Header="JSON pretty"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.JsonPretty}" />
                                            <MenuItem Header="Lines → JSON array"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.LinesToJsonArray}" />
                                        </MenuItem>
                                        <MenuItem Header="Encoding"
                                                  IsVisible="{Binding CanTransform}">
                                            <MenuItem Header="URL encode"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.UrlEncode}" />
                                            <MenuItem Header="URL decode"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.UrlDecode}" />
                                            <MenuItem Header="Base64 encode"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.Base64Encode}" />
                                            <MenuItem Header="Base64 decode"
                                                      Command="{Binding ApplyTextTransformationCommand}"
                                                      CommandParameter="{x:Static models:TextTransformation.Base64Decode}" />
                                        </MenuItem>
                                        <MenuItem Header="Clean terminal formatting"
                                                  IsVisible="{Binding CanTransform}"
                                                  Command="{Binding ApplyTextTransformationCommand}"
                                                  CommandParameter="{x:Static models:TextTransformation.CleanTerminalFormatting}" />
                                        <MenuItem Header="Text table → HTML"
                                                  IsVisible="{Binding CanTransform}"
                                                  Command="{Binding ApplyTextTransformationCommand}"
                                                  CommandParameter="{x:Static models:TextTransformation.BoxTableToHtml}" />
                                        <MenuItem Header="Scripts"
                                                  ItemsSource="{Binding #ClipsListBox.DataContext.VisibleUserScripts}"
                                                  IsVisible="{Binding #ClipsListBox.DataContext.HasVisibleUserScripts}">
                                            <MenuItem.Styles>
                                                <Style Selector="MenuItem" x:DataType="models:UserScript">
                                                    <Setter Property="Header" Value="{Binding Name}" />
                                                    <Setter Property="Command" Value="{Binding #ClipsListBox.DataContext.ApplyUserScriptCommand}" />
                                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                                </Style>
                                            </MenuItem.Styles>
                                        </MenuItem>
                                        <MenuItem Header="AI"
                                                  ItemsSource="{Binding #ClipsListBox.DataContext.VisibleAiMenuEntries}"
                                                  IsVisible="{Binding #ClipsListBox.DataContext.IsAiMenuVisible}">
                                            <MenuItem.Styles>
                                                <Style Selector="MenuItem" x:DataType="models:AiMenuEntry">
                                                    <Setter Property="Header" Value="{Binding Label}" />
                                                    <Setter Property="Command" Value="{Binding #ClipsListBox.DataContext.InvokeAiMenuEntryCommand}" />
                                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                                </Style>
                                            </MenuItem.Styles>
                                        </MenuItem>
                                    </MenuItem>
                                    <MenuItem Header="Extract text (OCR)"
                                              IsVisible="{Binding IsImageClip}"
                                              Command="{Binding #ClipsListBox.DataContext.RunOcrOnSelectedImageCommand}" />
                                    <Separator IsVisible="{Binding HasAnySourceInfo}" />
                                    <MenuItem Header="Open source URL"
                                              IsVisible="{Binding HasSourceUrl}"
                                              Command="{Binding #ClipsListBox.DataContext.OpenSelectedClipSourceUrlCommand}" />
                                    <MenuItem Header="Copy window title"
                                              IsVisible="{Binding HasSourceWindowTitle}"
                                              Command="{Binding #ClipsListBox.DataContext.CopySelectedClipWindowTitleCommand}" />
                                    <Separator />
                                    <MenuItem Header="{Binding DeleteLabel}"
                                              Command="{Binding DeleteCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ClipItemViewModel">
                                    <Border Classes="clip-row-card"
                                            Background="{Binding RowBackgroundBrush}"
                                            BorderBrush="{Binding RowBorderBrush}"
                                            BorderThickness="{Binding RowBorderThickness}"
                                            Padding="10,8">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                                              ColumnSpacing="4">
                                            <CheckBox Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayIndexText}"
                                                       Foreground="{Binding DisplayIndexForeground}"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       MinWidth="18"
                                                       TextAlignment="Center" />

                                            <Border Grid.Column="2"
                                                    Classes="clip-row-icon"
                                                    VerticalAlignment="Center">
                                                <Grid>
                                                    <Image Source="{Binding SourceAppIconImage}"
                                                           Width="18"
                                                           Height="18"
                                                           Stretch="Uniform"
                                                           AutomationProperties.Name="{Binding SourceApp}"
                                                           IsVisible="{Binding HasSourceAppIcon}" />
                                                    <TextBlock Text="{Binding TypeGlyph}"
                                                               Foreground="{Binding StateAccentBrush}"
                                                               VerticalAlignment="Center"
                                                               AutomationProperties.AccessibilityView="Raw"
                                                               IsVisible="{Binding ShowTypeGlyph}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        Spacing="4">
                                                <Grid ColumnDefinitions="Auto,*"
                                                      ColumnSpacing="10"
                                                      IsVisible="{Binding ShowPreviewThumbnail}">
                                                    <Image Grid.Column="0"
                                                           Source="{Binding PreviewThumbnailImage}"
                                                           Width="84"
                                                           Height="48"
                                                           Stretch="UniformToFill"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Spacing="2">
                                                        <TextBlock Text="{Binding SourceWindowTitle}"
                                                                   IsVisible="{Binding HasSourceWindowTitle}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding SourceWindowTitle}" />
                                                        <TextBlock Text="{Binding ThumbnailInfoCompact}"
                                                                   FontSize="11"
                                                                   Opacity="0.8"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Classes="clip-row-preview"
                                                           Text="{Binding SingleLinePreview}"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding ShowTextPreview}" />
                                                <WrapPanel Orientation="Horizontal"
                                                           ItemSpacing="4"
                                                           LineSpacing="2">
                                                    <Border Classes="meta-chip"
                                                            Padding="6,1"
                                                            Background="{Binding TypeChipBackground}"
                                                            BorderBrush="{Binding TypeChipBorderBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayContentType}"
                                                                   Foreground="{Binding TypeChipForeground}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Classes="meta-chip"
                                                            Padding="6,1"
                                                            Background="{Binding AgeChipBackground}"
                                                            BorderBrush="{Binding AgeChipBorderBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CapturedAtCompact}"
                                                                   Foreground="{Binding AgeChipForeground}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Classes="meta-chip"
                                                            Padding="6,1"
                                                            IsVisible="{Binding ShowWindowTitleChipInRow}"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="{Binding SourceWindowTitle}">
                                                        <TextBlock Text="{Binding SourceWindowTitle}"
                                                                   FontSize="10"
                                                                   MaxWidth="200"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                    <Border Classes="meta-chip"
                                                            Padding="6,1"
                                                            Background="{Binding PastedChipBackground}"
                                                            BorderBrush="{Binding PastedChipBorderBrush}"
                                                            IsVisible="{Binding HasBeenPasted}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PastedMarker}"
                                                                   Foreground="{Binding PastedChipForeground}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Classes="clip-row-date"
                                                               Text="{Binding CopyCountCompact}"
                                                               IsVisible="{Binding ShowCopyCountBadge}"
                                                               VerticalAlignment="Center"
                                                               FontSize="10" />
                                                    <TextBlock Text="{Binding FavoriteMarker}"
                                                               Foreground="{Binding StateAccentBrush}"
                                                               IsVisible="{Binding IsFavorite}"
                                                               VerticalAlignment="Center"
                                                               FontSize="10" />
                                                    <TextBlock Text="{Binding PinMarker}"
                                                               IsVisible="{Binding IsPinned}"
                                                               VerticalAlignment="Center"
                                                               FontSize="10"
                                                               ToolTip.Tip="Pinned" />
                                                    <Border Classes="badge-chip"
                                                            IsVisible="{Binding IsImported}"
                                                            ToolTip.Tip="Imported via drag-and-drop"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ImportedBadgeLabel}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <ProgressBar Grid.Row="2"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsBusyOrCapturing}"
                                 Height="4"
                                 Margin="0,-4,0,0"
                                 VerticalAlignment="Bottom" />

                    <Border Grid.Row="3"
                            Classes="inset-panel"
                            Padding="8,6">
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="8"
                                   LineSpacing="4">
                            <Border Classes="badge-chip"
                                    Background="{DynamicResource StatusChipSelectedBg}"
                                    BorderBrush="{DynamicResource StatusChipSelectedBorder}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding CheckedClipSummaryText}"
                                           Foreground="{DynamicResource StatusChipSelectedFg}" />
                            </Border>
                            <Border Classes="badge-chip"
                                    Background="{DynamicResource StatusChipMatchingBg}"
                                    BorderBrush="{DynamicResource StatusChipMatchingBorder}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding MatchingClipCountText}"
                                           Foreground="{DynamicResource StatusChipMatchingFg}" />
                            </Border>
                            <Border Classes="badge-chip"
                                    Background="{DynamicResource StatusChipSensitiveBg}"
                                    BorderBrush="{DynamicResource StatusChipSensitiveBorder}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SensitiveClipCountText}"
                                           Foreground="{DynamicResource StatusChipSensitiveFg}" />
                            </Border>
                            <Border Classes="badge-chip"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsSemanticCoverageVisible}"
                                    Background="{DynamicResource StatusChipSemanticBg}"
                                    BorderBrush="{DynamicResource StatusChipSemanticBorder}"
                                    ToolTip.Tip="{Binding SemanticCoverageText}">
                                <TextBlock Text="{Binding SemanticCoverageText}"
                                           Foreground="{DynamicResource StatusChipSemanticFg}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="220" />
                            </Border>
                            <Border Classes="badge-chip"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsOcrCoverageVisible}"
                                    Background="{DynamicResource StatusChipOcrBg}"
                                    BorderBrush="{DynamicResource StatusChipOcrBorder}"
                                    ToolTip.Tip="{Binding OcrCoverageText}">
                                <TextBlock Text="{Binding OcrCoverageText}"
                                           Foreground="{DynamicResource StatusChipOcrFg}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="240" />
                            </Border>
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Width="6" />

            <Border Grid.Column="2"
                    Classes="surface-panel"
                    MinWidth="620"
                    BorderBrush="{Binding SelectedClipAreaBorderBrush}"
                    BorderThickness="{Binding SelectedClipAreaBorderThickness}">
                <Grid RowDefinitions="Auto,*,Auto"
                      RowSpacing="10"
                      Margin="10">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="panel-caption"
                                           Text="{Binding SelectedClipContentTypeText}" />
                                <TextBlock Classes="panel-title"
                                           Foreground="{Binding SelectedClipAccentBrush}"
                                           Text="{Binding SelectedClipTitleText}"
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="body-muted"
                                           Text="{Binding SelectionStateTitle}"
                                           IsVisible="{Binding !HasSelectedClip}"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <Border Classes="badge-chip"
                                            IsVisible="{Binding ShowSelectedClipSeverityIndicator}"
                                            Background="{Binding SelectedClipSeverityBadgeBackground}"
                                            BorderBrush="{Binding SelectedClipSeverityBadgeBorderBrush}">
                                        <TextBlock Text="{Binding SelectedClipSeverityIndicatorText}"
                                                   Foreground="{Binding SelectedClipSeverityBadgeForeground}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="0"
                                            IsVisible="{Binding IsDisplayModeApplicable}">
                                    <RadioButton GroupName="DisplayMode"
                                                 Classes="segmented-left"
                                                 IsChecked="{Binding IsRenderedMode}"
                                                 Content="Rendered" />
                                    <RadioButton GroupName="DisplayMode"
                                                 Classes="segmented-center"
                                                 IsChecked="{Binding IsTextualMode}"
                                                 Content="Textual" />
                                    <RadioButton GroupName="DisplayMode"
                                                 Classes="segmented-right"
                                                 IsChecked="{Binding IsRawMode}"
                                                 Content="Raw" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="0"
                                            IsVisible="{Binding ShowSelectedImageRenderer}">
                                    <RadioButton GroupName="ImagePane"
                                                 Classes="segmented-left"
                                                 Content="{Binding ImageViewPreviewLabel}"
                                                 IsChecked="{Binding IsImagePreviewMode, Mode=TwoWay}" />
                                    <RadioButton GroupName="ImagePane"
                                                 Classes="segmented-center"
                                                 Content="{Binding ImageViewEditorLabel}"
                                                 IsChecked="{Binding IsImageEditorMode, Mode=TwoWay}" />
                                    <RadioButton GroupName="ImagePane"
                                                 Classes="segmented-right"
                                                 Content="{Binding ImageViewTextLabel}"
                                                 IsChecked="{Binding IsImageTextMode, Mode=TwoWay}"
                                                 ToolTip.Tip="{Binding SelectedClipOcrStatusText}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Grid.Row="1"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   ItemSpacing="8"
                                   LineSpacing="6">
                            <Button Classes="secondary compact"
                                    Command="{Binding CopySelectedCommand}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    Content="{Binding CopyButtonLabel}" />

                            <Button Classes="secondary compact"
                                    Command="{Binding ExportSelectedCommand}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    Content="{Binding ExportButtonLabel}" />

                            <Button Classes="secondary compact"
                                    Command="{Binding OpenInEditorCommand}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    Content="{Binding OpenInEditorButtonLabel}" />

                            <Button Classes="secondary compact"
                                    x:Name="ToolbarTransformButton"
                                    IsVisible="{Binding HasTransformableTarget}"
                                    ToolTip.Tip="Apply a text transformation (works on checked clips when any are selected)">
                                <Button.Content>Transform ▾</Button.Content>
                                <Button.Flyout>
                                    <MenuFlyout />
                                </Button.Flyout>
                            </Button>

                            <Button Classes="secondary compact"
                                    Command="{Binding CopyEditedClipCommand}"
                                    IsEnabled="{Binding HasEditedClipChanges}"
                                    IsVisible="{Binding !ShowSelectedImageEditor}"
                                    Content="{Binding CopyAsNewButtonLabel}" />

                            <Button Classes="secondary compact"
                                    Click="OnCopyEditedImageClick"
                                    IsVisible="{Binding ShowSelectedImageEditor}"
                                    Content="{Binding CopyAsNewButtonLabel}" />

                            <Button Classes="secondary compact"
                                    Click="OnResetEditedImageClick"
                                    IsVisible="{Binding ShowSelectedImageEditor}"
                                    Content="{Binding ResetImageEditsButtonLabel}" />

                            <Button Classes="secondary compact favorite-toggle"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    Classes.active="{Binding IsSelectedClipFavorite}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    Content="{Binding SelectedClipFavoriteButtonLabel}" />

                            <Button Classes="secondary compact"
                                    Command="{Binding TogglePinCommand}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    ToolTip.Tip="Pin/Unpin this clip"
                                    Content="{Binding SelectedClipPinButtonLabel}" />

                            <Button Classes="destructive compact"
                                    Command="{Binding DeleteSelectedCommand}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    Content="{Binding DeleteButtonLabel}" />
                        </WrapPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Classes="content-stage"
                            ClipToBounds="True"
                            BorderBrush="{Binding SelectedClipAreaBorderBrush}"
                            BorderThickness="{Binding SelectedClipAreaBorderThickness}">
                        <Grid>
                            <StackPanel IsVisible="{Binding ShowEmptySelectionState}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10"
                                        MaxWidth="420">
                                <TextBlock Text="📋"
                                           AutomationProperties.AccessibilityView="Raw"
                                           FontSize="44"
                                           HorizontalAlignment="Center" />
                                <TextBlock Classes="panel-title"
                                           HorizontalAlignment="Center"
                                           Text="{Binding EmptySelectionTitleText}" />
                                <TextBlock Classes="body-muted"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="{Binding EmptySelectionDescriptionText}" />
                            </StackPanel>

                            <controls:SyntaxTextEditor IsVisible="{Binding ShowRawTextContent}"
                                      IsReadOnly="{Binding SelectedClipTextIsReadOnly}"
                                      SyntaxHint="{Binding RawContentSyntaxHint}"
                                      SelectionStart="{Binding EditedClipSelectionStart, Mode=TwoWay}"
                                      SelectionLength="{Binding EditedClipSelectionLength, Mode=TwoWay}"
                                      Text="{Binding EditedClipText, Mode=TwoWay}" />

                            <controls:SyntaxTextEditor IsVisible="{Binding ShowSelectedTextRenderer}"
                                      IsReadOnly="{Binding SelectedClipTextIsReadOnly}"
                                      SelectionStart="{Binding EditedClipSelectionStart, Mode=TwoWay}"
                                      SelectionLength="{Binding EditedClipSelectionLength, Mode=TwoWay}"
                                      Text="{Binding EditedClipText, Mode=TwoWay}" />

                            <controls:RichWebContentView IsVisible="{Binding ShowSelectedRichTextRenderer}"
                                                          Markup="{Binding EditedClipText, Mode=TwoWay}"
                                                          IsReadOnly="{Binding SelectedClipRenderedContentIsReadOnly}"
                                                          ContentFormat="{Binding SelectedClipContentFormat}" />

                            <Grid IsVisible="{Binding ShowSelectedFilesRenderer}"
                                  Margin="14">
                                <Grid RowDefinitions="Auto,*"
                                      RowSpacing="12">
                                    <TextBlock Classes="body-muted"
                                               Text="{Binding SelectedClipRenderedText}" />

                                    <ListBox Grid.Row="1"
                                             Classes="file-list"
                                             ItemsSource="{Binding SelectedClipFiles}"
                                             SelectedItem="{Binding SelectedFileItem, Mode=TwoWay}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ClipFileItemViewModel">
                                                <Border Classes="file-item-row"
                                                        Margin="0,0,0,8"
                                                        Padding="12,10">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                                          ColumnSpacing="10">
                                                        <TextBlock Text="📄"
                                                                   VerticalAlignment="Center" />

                                                        <TextBox Grid.Column="1"
                                                                 Classes="file-path-box"
                                                                 IsReadOnly="True"
                                                                 Text="{Binding FilePath}" />

                                                        <TextBlock Grid.Column="2"
                                                                   Classes="body-muted"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding AvailabilityText}" />

                                                        <Button Grid.Column="3"
                                                                Classes="secondary compact"
                                                                Command="{Binding CopyPathCommand}"
                                                                Content="{Binding CopyLabel}" />

                                                        <StackPanel Grid.Column="4"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8">
                                                            <Button Classes="secondary compact"
                                                                    Command="{Binding OpenCommand}"
                                                                    IsEnabled="{Binding Exists}"
                                                                    Content="{Binding OpenLabel}" />
                                                            <Button Classes="secondary compact"
                                                                    Command="{Binding OpenContainingFolderCommand}"
                                                                    IsEnabled="{Binding Exists}"
                                                                    Content="{Binding FolderLabel}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>

                            <TextBox IsVisible="{Binding ShowSelectedFilesFallback}"
                                     Classes="content-viewer"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     HorizontalContentAlignment="Stretch"
                                     Text="{Binding SelectedClipRawContent}" />

                            <!-- Textual view for Files: each path rendered as a clickable link that opens it -->
                            <ScrollViewer IsVisible="{Binding ShowSelectedFilesTextual}"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="14">
                                <ItemsControl ItemsSource="{Binding SelectedClipFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ClipFileItemViewModel">
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="0,3"
                                                    Cursor="Hand"
                                                    Command="{Binding OpenCommand}"
                                                    IsEnabled="{Binding Exists}"
                                                    ToolTip.Tip="{Binding FilePath}">
                                                <TextBlock Text="{Binding FilePath}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SystemAccentColor}"
                                                           TextDecorations="Underline" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBox IsVisible="{Binding ShowSelectedFilesTextualFallback}"
                                     Classes="content-viewer"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     HorizontalContentAlignment="Stretch"
                                     Text="{Binding SelectedClipRawContent}" />

                            <Grid IsVisible="{Binding ShowSelectedImageRenderer}"
                                  Margin="14"
                                  RowDefinitions="*,Auto"
                                  RowSpacing="10">
                                <Border Grid.Row="0"
                                        Classes="image-placeholder"
                                         IsVisible="{Binding ShowSelectedImagePlaceholder}">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="10"
                                                MaxWidth="420">
                                        <TextBlock Text="🖼"
                                                   AutomationProperties.AccessibilityView="Raw"
                                                   FontSize="48"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Classes="panel-title"
                                                   HorizontalAlignment="Center"
                                                   Text="{Binding SelectedImageTypeText}" />
                                        <TextBlock Classes="body-muted"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding SelectedClipImageHint}" />
                                    </StackPanel>
                                </Border>

                                <Image Grid.Row="0"
                                       IsVisible="{Binding ShowSelectedImagePreview}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Source="{Binding SelectedClipImageBytes, Converter={x:Static conv:ImageBytesToBitmapConverter.Instance}}" />

                                <controls:EmbeddedImageEditorView Grid.Row="0"
                                                                  x:Name="SelectedImageEditor"
                                                                  IsVisible="{Binding ShowSelectedImageEditor}"
                                                                  MinHeight="450"
                                                                  SourceImageBytes="{Binding SelectedClipImageBytes}" />

                                <TextBox Grid.Row="0"
                                         IsVisible="{Binding ShowSelectedImageOcrTextBox}"
                                         Classes="content-viewer"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="300"
                                         Text="{Binding SelectedClipOcrText, Mode=OneWay}" />

                                <Border Grid.Row="0"
                                        IsVisible="{Binding ShowSelectedImageOcrEmptyState}"
                                        Classes="inset-panel"
                                        Padding="24"
                                        MinHeight="300"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <StackPanel Orientation="Vertical"
                                                Spacing="12"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Classes="body-muted"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding SelectedClipOcrStatusText}" />
                                        <Button Classes="accent"
                                                HorizontalAlignment="Center"
                                                Content="Run OCR now"
                                                Command="{Binding RunOcrOnSelectedImageCommand}"
                                                IsEnabled="{Binding CanRunOcrOnEmptyState}" />
                                        <TextBlock Classes="body-muted"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Opacity="0.7"
                                                   IsVisible="{Binding !CanRunOcr}"
                                                   Text="OCR engine unavailable. Configure OCR languages in Settings." />
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            Spacing="12"
                                            HorizontalAlignment="Center">
                                    <TextBlock Classes="body-muted"
                                               Text="{Binding SelectedClipImageResolutionText}" />
                                    <TextBlock Classes="body-muted"
                                               Text="{Binding SelectedClipOcrStatusText}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Classes="inset-panel"
                            Padding="10,6">
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="6"
                                   LineSpacing="4">
                            <Border Classes="meta-chip"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4">
                                    <Image Source="{Binding SelectedClipSourceAppIcon}"
                                           Width="14"
                                           Height="14"
                                           Stretch="Uniform"
                                           IsVisible="{Binding ShowSelectedClipSourceAppIcon}" />
                                    <TextBlock Classes="body-muted"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Text="{Binding SelectedClipSourceText}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="meta-chip"
                                    Padding="8,2"
                                    IsVisible="{Binding ShowSelectedClipWindowTitle}"
                                    VerticalAlignment="Center">
                                <TextBlock Classes="body-muted"
                                           FontSize="11"
                                           MaxWidth="260"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Text="{Binding SelectedClipWindowTitleText}" />
                            </Border>
                            <Button Classes="link"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding HasSelectedClipLineage}"
                                    Command="{Binding NavigateToLineageSourceCommand}"
                                    ToolTip.Tip="Jump to source clip">
                                <Border Padding="8,2"
                                        CornerRadius="999"
                                        BorderThickness="1"
                                        Background="#1E1444"
                                        BorderBrush="#7C3AED">
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="#C4B5FD"
                                               Text="{Binding SelectedClipLineageText}" />
                                </Border>
                            </Button>
                            <Border Padding="8,2"
                                    CornerRadius="999"
                                    BorderThickness="1"
                                    Background="{Binding SelectedClipPastedChipBackground}"
                                    BorderBrush="{Binding SelectedClipPastedChipBorderBrush}"
                                    IsVisible="{Binding ShowSelectedClipPasted}"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding SelectedClipPastedChipForeground}"
                                           Text="{Binding SelectedClipPastedText}" />
                            </Border>
                            <Border Padding="8,2"
                                    CornerRadius="999"
                                    BorderThickness="1"
                                    Background="{Binding SelectedClipTypeChipBackground}"
                                    BorderBrush="{Binding SelectedClipTypeChipBorderBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding SelectedClipTypeChipForeground}"
                                           Text="{Binding SelectedClipContentTypeText}" />
                            </Border>
                            <Border Padding="8,2"
                                    CornerRadius="999"
                                    BorderThickness="1"
                                    Background="{Binding SelectedClipAgeChipBackground}"
                                    BorderBrush="{Binding SelectedClipAgeChipBorderBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding SelectedClipAgeChipForeground}"
                                           Text="{Binding SelectedClipFirstCopiedAtText}" />
                            </Border>
                            <Border Classes="meta-chip"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Classes="body-muted"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Text="{Binding SelectedClipCapturedAtText}" />
                            </Border>
                            <Border Classes="meta-chip"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Classes="body-muted"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Text="{Binding SelectedClipExpiresAtText}" />
                            </Border>
                            <Border Classes="meta-chip"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding HasSelectedClipMultipleCopies}"
                                    ToolTip.Tip="Number of times this clip was copied (deduplicated entries)">
                                <TextBlock Classes="body-muted"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Text="{Binding SelectedClipCopyCountText}" />
                            </Border>
                            <Border Padding="8,2"
                                    CornerRadius="999"
                                    BorderThickness="1"
                                    Background="{Binding SelectedClipSizeChipBackground}"
                                    BorderBrush="{Binding SelectedClipSizeChipBorderBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding SelectedClipSizeChipForeground}"
                                           Text="{Binding SelectedClipByteSizeText}" />
                            </Border>
                            <Border Classes="meta-chip"
                                    Padding="8,2"
                                    IsVisible="{Binding ShowSelectedImageResolutionCard}"
                                    VerticalAlignment="Center">
                                <TextBlock Classes="body-muted"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Text="{Binding SelectedClipImageResolutionText}" />
                            </Border>
                            <Border Padding="8,2"
                                    CornerRadius="999"
                                    BorderThickness="1"
                                    Background="{Binding SelectedClipSensitivityChipBackground}"
                                    BorderBrush="{Binding SelectedClipSensitivityChipBorderBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding SelectedClipSensitivityChipForeground}"
                                           Text="{Binding SelectedClipSensitivityText}" />
                            </Border>
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Classes="inset-panel footer-panel"
                Padding="12,6">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="14"
                  VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock Classes="body-muted"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="300"
                               Text="{Binding ActiveFilterSummary}" />
                    <Border Classes="badge-chip"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding LastCaptureSummary}" />
                    </Border>
                    <Border Classes="badge-chip"
                            Background="#1E1444"
                            BorderBrush="#7C3AED"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            IsVisible="{Binding HasRunningJobs}"
                            ToolTip.Tip="{Binding RunningJobsLabel}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="⏳"
                                       VerticalAlignment="Center"
                                       Foreground="#C4B5FD" />
                            <TextBlock Text="{Binding RunningJobsLabel}"
                                       VerticalAlignment="Center"
                                       Foreground="#C4B5FD"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="220" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Classes="detail-stat-card"
                            Padding="8,4"
                            MinWidth="280">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <TextBlock Classes="detail-label"
                                           FontSize="10"
                                           Text="{Binding StorageUsageText}" />
                                <TextBlock Grid.Column="1"
                                           Classes="body-muted"
                                           FontSize="10"
                                           Text="{Binding StorageCapacityText}" />
                            </Grid>
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding StorageUsagePercent}"
                                         Height="4" />
                        </StackPanel>
                    </Border>

                    <Border Classes="detail-stat-card"
                            Padding="8,4"
                            MinWidth="280">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <TextBlock Classes="detail-label"
                                           FontSize="10"
                                           Text="{Binding EntryUsageText}" />
                                <TextBlock Grid.Column="1"
                                           Classes="body-muted"
                                           FontSize="10"
                                           Text="{Binding EntryCapacityText}" />
                            </Grid>
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding EntryUsagePercent}"
                                         Height="4" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="secondary compact"
                            Command="{Binding SessionLogs.OpenCommand}"
                            Content="{Binding LogsButtonLabel}" />
                    <Button Classes="secondary compact"
                            Command="{Binding OpenSettingsCommand}"
                            Content="{Binding SettingsButtonLabel}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.RowSpan="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,16,16,0"
                IsHitTestVisible="True">
            <ItemsControl ItemsSource="{Binding Notifications}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppNotificationViewModel">
                        <Border Background="{Binding Background}"
                                BorderBrush="{Binding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,8"
                                Width="360"
                                IsHitTestVisible="True">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12">
                                    <TextBlock Classes="detail-label"
                                               Text="{Binding Title}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="body-muted"
                                               Text="{Binding TimestampText}" />
                                 </Grid>
                                 <TextBlock Text="{Binding Message}"
                                            TextWrapping="Wrap" />
                                 <ItemsControl ItemsSource="{Binding Actions}"
                                               IsVisible="{Binding HasActions}">
                                     <ItemsControl.ItemsPanel>
                                         <ItemsPanelTemplate>
                                             <StackPanel Orientation="Horizontal"
                                                         Spacing="8" />
                                         </ItemsPanelTemplate>
                                     </ItemsControl.ItemsPanel>
                                     <ItemsControl.ItemTemplate>
                                         <DataTemplate x:DataType="vm:AppNotificationActionViewModel">
                                             <Button Classes="secondary compact"
                                                     Command="{Binding ExecuteCommand}"
                                                     Content="{Binding Label}" />
                                         </DataTemplate>
                                     </ItemsControl.ItemTemplate>
                                 </ItemsControl>
                             </StackPanel>
                         </Border>
                     </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        </Grid>

        <Border IsVisible="{Binding IsWelcomeOpen}"
                Margin="10"
                Classes="hero-surface"
                Padding="28">
            <Panel>
            <Grid RowDefinitions="Auto,*,Auto"
                  RowSpacing="18"
                  IsVisible="{Binding !IsLoadingDatabase}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="eyebrow"
                               Text="{Binding WindowTitle}" />
                    <TextBlock Classes="hero-title"
                               Text="{Binding WelcomeTitleText}" />
                    <TextBlock Classes="body-muted"
                               MaxWidth="760"
                               Text="{Binding WelcomeDescriptionText}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid ColumnDefinitions="340,*"
                          ColumnSpacing="24">
                        <StackPanel Spacing="14">
                            <Border Classes="surface-panel"
                                    Padding="18">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="panel-caption"
                                               Text="{Binding SettingsStorageTitle}" />
                                    <TextBlock Text="{Binding SettingsStorageHintText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Classes="surface-panel"
                                    Padding="18">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="panel-caption"
                                               Text="{Binding SettingsGlobalHotkeyTitle}" />
                                    <TextBlock Text="{Binding SettingsHintText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="14">
                            <Border Classes="surface-panel"
                                    Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="panel-caption"
                                               Text="{Binding SettingsStorageTitle}" />

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="detail-label"
                                                   Text="{Binding SettingsDatabasePathLabel}" />
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8">
                                            <TextBox x:Name="WelcomeDatabasePathTextBox"
                                                     Text="{Binding SettingsDatabasePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button x:Name="WelcomeDatabasePathBrowseButton"
                                                    Grid.Column="1"
                                                    Classes="secondary compact"
                                                    Command="{Binding BrowseDatabasePathCommand}"
                                                    CommandParameter="{Binding $parent[Window]}"
                                                    Content="{Binding SettingsBrowseDatabasePathButtonLabel}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="detail-label"
                                                   Text="{Binding SettingsDatabasePasswordLabel}" />
                                        <TextBox x:Name="WelcomeDatabasePasswordTextBox"
                                                 Text="{Binding SettingsDatabasePassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PasswordChar="*"
                                                 RevealPassword="{Binding IsDatabasePasswordVisible}" />
                                        <TextBlock Classes="detail-label"
                                                   Text="Confirm password" />
                                        <TextBox Text="{Binding SettingsDatabasePasswordConfirm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PasswordChar="*"
                                                 RevealPassword="{Binding IsDatabasePasswordVisible}" />
                                        <TextBlock Text="Passwords do not match."
                                                   IsVisible="{Binding IsPasswordMismatchVisible}"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   FontSize="11" />
                                        <CheckBox Content="{Binding SettingsShowPasswordLabel}"
                                                  IsChecked="{Binding IsDatabasePasswordVisible}" />
                                        <CheckBox Content="Remember password (saved as plaintext in storage.json)"
                                                  IsChecked="{Binding SettingsRememberDatabasePassword, Mode=TwoWay}"
                                                  IsVisible="{Binding SettingsDatabasePassword, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Classes="body-muted"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding IsRememberPasswordWarningVisible}"
                                                   Text="{Binding SettingsDatabasePasswordWarningText}" />
                                        <TextBlock Text="Warning: if you forget this password, your database cannot be recovered."
                                                   Classes="body-muted"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="surface-panel"
                                    Padding="18">
                                <StackPanel Spacing="14">
                                    <TextBlock Classes="panel-caption"
                                               Text="{Binding SettingsGlobalHotkeyTitle}" />
                                    <Grid ColumnDefinitions="Auto,260,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto"
                                          ColumnSpacing="12"
                                          RowSpacing="10">
                                        <CheckBox Content="{Binding SettingsEnableShortcutLabel}"
                                                  IsChecked="{Binding SettingsEnableToggleWindowHotkey}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsToggleWindowHotkeyLabel}" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding SettingsToggleWindowHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsClipLimitLabel}" />
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="2"
                                                 Text="{Binding SettingsMaxClipSizeKilobytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="surface-panel"
                                    Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="panel-caption"
                                               Text="{Binding SettingsBehaviorTitle}" />
                                    <CheckBox Content="{Binding SettingsCloseToTrayLabel}"
                                              IsChecked="{Binding SettingsCloseToTray}" />
                                    <CheckBox Content="{Binding SettingsMinimizeToTrayLabel}"
                                              IsChecked="{Binding SettingsMinimizeToTray}" />
                                    <CheckBox Content="{Binding SettingsStartWithWindowsLabel}"
                                              IsChecked="{Binding SettingsStartWithWindows}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Grid Grid.Row="2"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="16">
                    <TextBlock Classes="body-muted"
                               VerticalAlignment="Center"
                               Text="{Binding StatusText}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Classes="primary"
                            Command="{Binding SaveSettingsCommand}"
                            Content="{Binding WelcomeSaveButtonLabel}" />
                </Grid>
            </Grid>

            <StackPanel IsVisible="{Binding IsLoadingDatabase}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                <TextBlock Classes="hero-title"
                           HorizontalAlignment="Center"
                           Text="Creating Clipboard Library" />
                <ProgressBar IsIndeterminate="True"
                             Width="240"
                             HorizontalAlignment="Center" />
                <TextBlock Classes="body-muted"
                           HorizontalAlignment="Center"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap" />
            </StackPanel>
            </Panel>
        </Border>

        <!-- Password Prompt Panel -->
        <Border IsVisible="{Binding IsPasswordPromptOpen}"
                Margin="10"
                Classes="hero-surface"
                Padding="28">
            <Grid RowDefinitions="Auto,*,Auto"
                  RowSpacing="18"
                  MaxWidth="480"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <StackPanel Spacing="8">
                    <TextBlock Classes="eyebrow"
                               Text="{Binding WindowTitle}" />
                    <TextBlock Classes="hero-title"
                               Text="Enter Database Password" />
                    <TextBlock Classes="body-muted"
                               Text="Your clipboard database is encrypted. Enter the password to unlock it."
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Spacing="14"
                            VerticalAlignment="Center">
                    <Border Classes="surface-panel"
                            Padding="18">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="detail-label"
                                           Text="Password" />
                                <TextBox Text="{Binding PasswordPromptInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PasswordChar="*"
                                         RevealPassword="{Binding IsPasswordPromptPasswordVisible}"
                                         PlaceholderText="Enter your database password" />
                                <CheckBox Content="Show password"
                                          IsChecked="{Binding IsPasswordPromptPasswordVisible}" />
                            </StackPanel>

                            <TextBlock Text="{Binding PasswordPromptError}"
                                       IsVisible="{Binding PasswordPromptError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2"
                      ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="12">
                    <Button Classes="secondary"
                            Command="{Binding ExitApplicationCommand}"
                            Content="Exit" />
                    <Button Grid.Column="2"
                            Classes="primary"
                            Command="{Binding UnlockDatabaseCommand}"
                            Content="Unlock" />
                </Grid>
            </Grid>
        </Border>

        <!-- Loading Database Overlay -->
        <Border IsVisible="{Binding IsLoadingDatabase}"
                Margin="10"
                Classes="hero-surface"
                Padding="28">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                <TextBlock Classes="hero-title"
                           HorizontalAlignment="Center"
                           Text="Loading Clipboard Library" />
                <ProgressBar IsIndeterminate="True"
                             Width="240"
                             HorizontalAlignment="Center" />
                <TextBlock Classes="body-muted"
                           HorizontalAlignment="Center"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Startup Error Overlay -->
        <Border IsVisible="{Binding HasStartupError}"
                Margin="10"
                Classes="hero-surface"
                Padding="28">
            <Grid RowDefinitions="Auto,*,Auto"
                  RowSpacing="18"
                  MaxWidth="560"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <StackPanel Spacing="8">
                    <TextBlock Classes="eyebrow"
                               Text="{Binding WindowTitle}" />
                    <TextBlock Classes="hero-title"
                               Text="{Binding StartupErrorTitle}" />
                    <TextBlock Classes="body-muted"
                               Text="The clip library failed to load. Your data may be intact &#x2014; open the logs folder for details."
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Row="1"
                        Classes="surface-panel"
                        Padding="18">
                    <TextBlock Text="{Binding StartupErrorMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               FontSize="12" />
                </Border>

                <Grid Grid.Row="2"
                      ColumnDefinitions="Auto,Auto,*,Auto"
                      ColumnSpacing="12">
                    <Button Classes="secondary"
                            Command="{Binding Maintenance.OpenLogsFolderCommand}"
                            Content="Open logs folder" />
                    <Button Grid.Column="1"
                            Classes="secondary"
                            Command="{Binding Maintenance.OpenDatabaseFolderCommand}"
                            Content="Open database folder" />
                    <Button Grid.Column="3"
                            Classes="primary"
                            Command="{Binding ExitApplicationCommand}"
                            Content="Exit" />
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
