<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaApplication1.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="820"
        x:Class="AvaloniaApplication1.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Clipthrough"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="640">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Padding="20,16"
                BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="8">
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Clipthrough"
                           FontSize="24"
                           FontWeight="SemiBold" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Search, filter, and review clipboard history without loading everything into memory."
                           Foreground="{DynamicResource ThemeForegroundLowBrush}" />

                <TextBox Grid.Row="0"
                         Grid.RowSpan="2"
                         Grid.Column="1"
                         MinWidth="360"
                         Watermark="Search clips..."
                         Text="{Binding SearchText}" />

                <ComboBox Grid.Row="0"
                          Grid.RowSpan="2"
                          Grid.Column="2"
                          MinWidth="120"
                          ItemsSource="{Binding ContentTypeOptions}"
                          SelectedItem="{Binding SelectedContentType}" />

                <CheckBox Grid.Row="0"
                          Grid.RowSpan="2"
                          Grid.Column="3"
                          VerticalAlignment="Center"
                          IsChecked="{Binding ShowFavoritesOnly}">
                    Favorites
                </CheckBox>

                <CheckBox Grid.Row="0"
                          Grid.RowSpan="2"
                          Grid.Column="4"
                          VerticalAlignment="Center"
                          IsChecked="{Binding ShowSensitiveOnly}">
                    Sensitive
                </CheckBox>

                <Button Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="5"
                        MinWidth="96"
                        Command="{Binding RefreshCommand}">
                    Refresh
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="2*,5,3*">
            <DockPanel Grid.Column="0"
                       LastChildFill="True"
                       Margin="20,20,10,20">
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Stretch"
                            Spacing="12"
                            Margin="0,12,0,0">
                    <Button Command="{Binding LoadMoreCommand}"
                            IsEnabled="{Binding HasMoreResults}">
                        Load more
                    </Button>
                    <TextBlock VerticalAlignment="Center"
                               Text="Refreshing..."
                               IsVisible="{Binding IsBusy}" />
                </StackPanel>

                <Border Padding="12"
                        CornerRadius="12"
                        Background="{DynamicResource ThemeControlMidBrush}">
                    <ListBox ItemsSource="{Binding Clips}"
                             SelectedItem="{Binding SelectedClip, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClipItemViewModel">
                                <Border Margin="0,0,0,10"
                                        Padding="14"
                                        CornerRadius="10"
                                        Background="{DynamicResource ThemeControlLowBrush}">
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          RowDefinitions="Auto,Auto"
                                          ColumnSpacing="12"
                                          RowSpacing="6">
                                        <TextBlock Grid.RowSpan="2"
                                                   Text="{Binding TypeGlyph}"
                                                   FontSize="20"
                                                   VerticalAlignment="Top" />

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />

                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Top">
                                            <TextBlock Text="★"
                                                       IsVisible="{Binding IsFavorite}" />
                                            <TextBlock Text="🛡"
                                                       IsVisible="{Binding IsSensitive}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding Subtitle}"
                                                   Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Background="{DynamicResource ThemeBorderMidBrush}" />

            <Border Grid.Column="2"
                    Margin="10,20,20,20"
                    Padding="20"
                    CornerRadius="12"
                    Background="{DynamicResource ThemeControlMidBrush}">
                <Grid RowDefinitions="Auto,Auto,*,Auto"
                      RowSpacing="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Preview"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedClip.Title, TargetNullValue='Select a clip'}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SelectedClip.Subtitle, TargetNullValue='Choose an item from the list to inspect its details.'}"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Padding="14"
                            CornerRadius="10"
                            Background="{DynamicResource ThemeControlLowBrush}">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              RowSpacing="8">
                            <TextBlock Text="Source" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding SelectedClip.SourceApp, TargetNullValue='Unknown source'}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Captured" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding SelectedClip.CapturedAtDisplay, TargetNullValue='—'}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Type" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding SelectedClip.DisplayContentType, TargetNullValue='—'}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Sensitivity" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Text="{Binding SelectedClip.SensitivitySummary, TargetNullValue='No clip selected'}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <TextBox Grid.Row="2"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             HorizontalContentAlignment="Stretch"
                             Text="{Binding SelectedClip.FullContent, TargetNullValue='Select a clip to preview its full content.'}" />

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="12">
                        <Button Command="{Binding ToggleFavoriteCommand}"
                                Content="{Binding SelectedClipActionText}" />
                        <Button Command="{Binding DeleteSelectedCommand}">
                            Delete
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="20,12"
                BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" />
        </Border>
    </Grid>
</Window>
