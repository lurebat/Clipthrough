<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Clipthrough.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1360"
        d:DesignHeight="860"
        x:Class="Clipthrough.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Clipthrough"
        Width="1360"
        Height="860"
        MinWidth="1080"
        MinHeight="700">

    <Grid RowDefinitions="Auto,*,Auto"
          RowSpacing="18"
          Margin="20">
        <Border Grid.Row="0"
                Classes="hero-surface"
                Padding="28">
            <Grid ColumnDefinitions="1.9*,1.2*"
                  ColumnSpacing="24">
                <StackPanel Spacing="12">
                    <TextBlock Classes="eyebrow"
                               Text="Clipboard workspace" />
                    <TextBlock Classes="hero-title"
                               Text="Clipthrough" />
                    <TextBlock Classes="body-muted"
                               MaxWidth="620"
                               TextWrapping="Wrap"
                               Text="Inspired by classic clipboard tools, rebuilt as a calmer, modern command center for searching, reviewing, and organizing your clipboard history." />

                    <Grid Margin="0,12,0,0"
                          ColumnDefinitions="*,*,*"
                          ColumnSpacing="14">
                        <Border Grid.Column="0"
                                Classes="stat-card"
                                Padding="18">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="metric-value"
                                           Text="{Binding MatchingClipCount}" />
                                <TextBlock Classes="metric-label"
                                           Text="Matching clips" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Classes="stat-card"
                                Padding="18">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="metric-value"
                                           Text="{Binding TotalClipCount}" />
                                <TextBlock Classes="metric-label"
                                           Text="Stored in library" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Classes="stat-card"
                                Padding="18">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="metric-value"
                                           Text="{Binding SensitiveClipCount}" />
                                <TextBlock Classes="metric-label"
                                           Text="Marked sensitive" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <Border Grid.Column="1"
                        Classes="surface-subpanel"
                        Padding="22">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="14">
                        <TextBlock Classes="card-title"
                                   Text="Filter library" />

                        <TextBox Grid.Row="1"
                                 Watermark="Search clips, apps, or phrases"
                                 Text="{Binding SearchText}" />

                        <Grid Grid.Row="2"
                              ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="12">
                            <ComboBox Grid.Row="0"
                                      Grid.Column="0"
                                      ItemsSource="{Binding ContentTypeOptions}"
                                      SelectedItem="{Binding SelectedContentType}" />

                            <Button Grid.Row="0"
                                    Grid.Column="1"
                                    Classes="primary"
                                    Command="{Binding RefreshCommand}"
                                    Content="Refresh" />

                            <CheckBox Grid.Row="1"
                                      Grid.Column="0"
                                      Classes="filter-toggle"
                                      IsChecked="{Binding ShowFavoritesOnly}"
                                      Content="Favorites only" />

                            <CheckBox Grid.Row="1"
                                      Grid.Column="1"
                                      Classes="filter-toggle"
                                      IsChecked="{Binding ShowSensitiveOnly}"
                                      Content="Sensitive only" />
                        </Grid>

                        <TextBlock Grid.Row="3"
                                   Classes="body-muted"
                                   TextWrapping="Wrap"
                                   Text="{Binding ActiveFilterSummary}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="1.25*,6,*"
              ColumnSpacing="18">
            <Border Grid.Column="0"
                    Classes="surface-panel">
                <Grid RowDefinitions="Auto,*,Auto"
                      RowSpacing="16"
                      Margin="18">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="section-title"
                                   Text="Recent clips" />
                        <TextBlock Classes="body-muted"
                                   Text="{Binding LastCaptureSummary}" />
                    </StackPanel>

                    <Grid Grid.Row="1"
                          RowDefinitions="Auto,*"
                          RowSpacing="12">
                        <TextBlock Classes="empty-state"
                                   IsVisible="{Binding HasNoClips}"
                                   Text="{Binding EmptyListMessage}" />

                        <ListBox Grid.Row="1"
                                 Classes="clip-list"
                                 ItemsSource="{Binding Clips}"
                                 SelectedItem="{Binding SelectedClip, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ClipItemViewModel">
                                    <Border Classes="clip-card"
                                            Padding="16">
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              RowDefinitions="Auto,Auto,Auto"
                                              ColumnSpacing="12"
                                              RowSpacing="10">
                                            <Border Grid.RowSpan="2"
                                                    Classes="meta-chip"
                                                    Padding="12,10"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding TypeGlyph}"
                                                           FontSize="20" />
                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       Classes="item-title"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        HorizontalAlignment="Right">
                                                <Border Classes="badge-chip favorite"
                                                        IsVisible="{Binding IsFavorite}">
                                                    <TextBlock Text="Pinned"
                                                               FontSize="11"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                                <Border Classes="badge-chip sensitive"
                                                        IsVisible="{Binding IsSensitive}">
                                                    <TextBlock Text="Sensitive"
                                                               FontSize="11"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Grid.ColumnSpan="2"
                                                       Classes="item-preview"
                                                       Text="{Binding PreviewSnippet}" />

                                            <WrapPanel Grid.Row="2"
                                                       Grid.Column="1"
                                                       Grid.ColumnSpan="2"
                                                       Orientation="Horizontal"
                                                       ItemSpacing="8"
                                                       LineSpacing="8">
                                                <Border Classes="meta-chip"
                                                        Padding="10,6">
                                                    <TextBlock Text="{Binding DisplayContentType}"
                                                               FontSize="12" />
                                                </Border>
                                                <Border Classes="meta-chip"
                                                        Padding="10,6">
                                                    <TextBlock Text="{Binding RelativeCapturedAt}"
                                                               FontSize="12" />
                                                </Border>
                                                <Border Classes="meta-chip"
                                                        Padding="10,6">
                                                    <TextBlock Text="{Binding SourceApp}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.Row="2"
                            Classes="inset-panel"
                            Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="14">
                            <TextBlock Classes="body-muted"
                                       VerticalAlignment="Center"
                                       Text="{Binding ClipboardStateText}" />

                            <Button Grid.Column="1"
                                    Classes="secondary"
                                    Command="{Binding LoadMoreCommand}"
                                    IsEnabled="{Binding HasMoreResults}"
                                    Content="Load more" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Width="6" />

            <Border Grid.Column="2"
                    Classes="surface-panel">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
                      RowSpacing="16"
                      Margin="22">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="18">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="eyebrow"
                                       Text="Preview" />
                            <TextBlock Classes="section-title"
                                       Text="{Binding SelectedClip.Title, TargetNullValue='Select a clip'}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="body-muted"
                                       TextWrapping="Wrap"
                                       Text="{Binding SelectionStateTitle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Spacing="10">
                            <Button Classes="secondary"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    Content="{Binding SelectedClipActionText}" />
                            <Button Classes="destructive"
                                    Command="{Binding DeleteSelectedCommand}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    Content="Delete" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Grid.Row="1"
                               ItemSpacing="10"
                               LineSpacing="10">
                        <Border Classes="meta-chip"
                                Padding="12,8">
                            <TextBlock Text="{Binding SelectedClip.DisplayContentType, TargetNullValue='No type'}" />
                        </Border>
                        <Border Classes="meta-chip"
                                Padding="12,8">
                            <TextBlock Text="{Binding SelectedClip.SourceApp, TargetNullValue='Unknown source'}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Border Classes="meta-chip"
                                Padding="12,8">
                            <TextBlock Text="{Binding SelectedClip.CapturedAtDisplay, TargetNullValue='No capture time'}" />
                        </Border>
                        <Border Classes="meta-chip"
                                Padding="12,8">
                            <TextBlock Text="{Binding SelectedClip.ByteSizeDisplay, TargetNullValue='0 bytes'}" />
                        </Border>
                    </WrapPanel>

                    <Border Grid.Row="2"
                            Classes="surface-subpanel"
                            Padding="18">
                        <Grid ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="16"
                              RowSpacing="10">
                            <TextBlock Text="Source"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedClip.SourceApp, TargetNullValue='Unknown source'}" />

                            <TextBlock Grid.Row="1"
                                       Text="Captured"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding SelectedClip.CapturedAtDisplay, TargetNullValue='—'}" />

                            <TextBlock Grid.Row="2"
                                       Text="Type"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding SelectedClip.DisplayContentType, TargetNullValue='—'}" />

                            <TextBlock Grid.Row="3"
                                       Text="Sensitivity"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       TextWrapping="Wrap"
                                       Text="{Binding SelectedClip.SensitivitySummary, TargetNullValue='No clip selected'}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Classes="inset-panel"
                            Padding="0">
                        <TextBox Classes="preview-editor"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 HorizontalContentAlignment="Stretch"
                                 Text="{Binding SelectedClip.FullContent, TargetNullValue='Select a clip to preview its full content.'}" />
                    </Border>

                    <Border Grid.Row="4"
                            Classes="inset-panel"
                            Padding="14,12">
                        <TextBlock Classes="body-muted"
                                   TextWrapping="Wrap"
                                   Text="{Binding StatusText}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Classes="inset-panel"
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <TextBlock Classes="body-muted"
                           Text="{Binding ActiveFilterSummary}" />
                <TextBlock Grid.Column="1"
                           Classes="body-muted"
                           Text="{Binding LastCaptureSummary}" />
            </Grid>
        </Border>
    </Grid>
</Window>
