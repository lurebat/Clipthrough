<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Clipthrough.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1360"
        d:DesignHeight="860"
        x:Class="Clipthrough.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Clipthrough"
        Width="1360"
        Height="860"
        MinWidth="1080"
        MinHeight="700">

    <Grid RowDefinitions="Auto,*,Auto"
          RowSpacing="12"
          Margin="14">
        <Border Grid.Row="0"
                Classes="hero-toolbar"
                Padding="14,12">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="18">
                <TextBlock Classes="window-title"
                           VerticalAlignment="Center"
                           Text="Clipthrough" />

                <TextBox Grid.Column="1"
                         Watermark="Filter clips"
                         Text="{Binding SearchText}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="380,6,*"
              ColumnSpacing="12">
            <Border Grid.Column="0"
                    Classes="surface-panel">
                <Grid RowDefinitions="Auto,Auto,*,Auto"
                      RowSpacing="12"
                      Margin="16">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="panel-caption"
                                       Text="Clipboard history" />
                            <TextBlock Classes="panel-title"
                                       Text="Clips" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Classes="body-muted"
                                   VerticalAlignment="Center"
                                   Text="{Binding MatchingClipCount, StringFormat='Matching {0:N0}'}" />
                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="150,Auto,Auto,Auto,Auto"
                          ColumnSpacing="10">
                        <ComboBox Classes="compact-field"
                                  ItemsSource="{Binding ContentTypeOptions}"
                                  SelectedItem="{Binding SelectedContentType}" />

                        <CheckBox Grid.Column="1"
                                  Classes="filter-toggle compact-toggle"
                                  IsChecked="{Binding ShowFavoritesOnly}"
                                  Content="Favorites" />

                        <CheckBox Grid.Column="2"
                                  Classes="filter-toggle compact-toggle"
                                  IsChecked="{Binding ShowSensitiveOnly}"
                                  Content="Sensitive" />

                        <CheckBox Grid.Column="3"
                                  Classes="filter-toggle compact-toggle"
                                  IsChecked="{Binding UseRegexSearch}"
                                  Content="Regex" />

                        <Button Grid.Column="4"
                                Classes="secondary compact"
                                Command="{Binding RefreshCommand}"
                                Content="Refresh" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <TextBlock Classes="empty-state"
                                   IsVisible="{Binding HasNoClips}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding EmptyListMessage}" />

                        <ListBox x:Name="ClipsListBox"
                                 Classes="clip-list"
                                 ItemsSource="{Binding Clips}"
                                 SelectedItem="{Binding SelectedClip, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ClipItemViewModel">
                                    <Border Classes="clip-row-card"
                                            BorderBrush="{Binding RowBorderBrush}"
                                            BorderThickness="{Binding RowBorderThickness}"
                                            Padding="10,8">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                              ColumnSpacing="10">
                                            <TextBlock Text="{Binding FavoriteMarker}"
                                                       Foreground="{Binding StateAccentBrush}"
                                                       FontSize="15"
                                                       Width="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding IsFavorite}" />

                                            <Border Grid.Column="1"
                                                    Classes="clip-row-icon"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeGlyph}"
                                                           Foreground="{Binding StateAccentBrush}"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock Grid.Column="2"
                                                       Classes="clip-row-preview"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding SingleLinePreview}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FavoriteMarker}"
                                                           Foreground="{Binding StateAccentBrush}"
                                                           IsVisible="{Binding IsFavorite}" />
                                                <TextBlock Classes="clip-row-date"
                                                           Text="{Binding CapturedAtCompact}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.Row="3"
                            Classes="inset-panel"
                            Padding="12,10">
                        <TextBlock Classes="body-muted"
                                   VerticalAlignment="Center"
                                   Text="{Binding ClipboardStateText}" />
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Width="6" />

            <Border Grid.Column="2"
                    Classes="surface-panel">
                <Grid RowDefinitions="Auto,*,Auto"
                      RowSpacing="12"
                      Margin="18">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="panel-caption"
                                       Text="{Binding SelectedClip.DisplayContentType, TargetNullValue='Clip'}" />
                            <TextBlock Classes="panel-title"
                                       Text="{Binding SelectedClip.Title, TargetNullValue='Select a clip'}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="body-muted"
                                       Text="{Binding SelectionStateTitle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="12"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBlock Classes="body-muted"
                                           VerticalAlignment="Center"
                                           Text="Raw" />
                                <ToggleSwitch IsChecked="{Binding ShowRawContent}"
                                              IsEnabled="{Binding HasSelectedClip}"
                                              VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Classes="secondary compact"
                                    Command="{Binding CopySelectedCommand}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    Content="Copy" />

                            <Button Classes="secondary compact"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    Content="{Binding SelectedClipActionText}" />

                            <Button Classes="destructive compact"
                                    Command="{Binding DeleteSelectedCommand}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    Content="Delete" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Classes="content-stage"
                            Padding="0">
                        <Grid>
                            <StackPanel IsVisible="{Binding ShowEmptySelectionState}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10"
                                        MaxWidth="420">
                                <TextBlock Text="📋"
                                           FontSize="44"
                                           HorizontalAlignment="Center" />
                                <TextBlock Classes="panel-title"
                                           HorizontalAlignment="Center"
                                           Text="Select a clip" />
                                <TextBlock Classes="body-muted"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="Choose a clip from the left to inspect its content, preview it in context, and review metadata below." />
                            </StackPanel>

                            <TextBox IsVisible="{Binding ShowRawTextContent}"
                                     Classes="content-viewer raw-content-viewer"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     HorizontalContentAlignment="Stretch"
                                     Text="{Binding SelectedClipRawContent}" />

                            <TextBox IsVisible="{Binding ShowSelectedTextRenderer}"
                                     Classes="content-viewer"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     HorizontalContentAlignment="Stretch"
                                     Text="{Binding SelectedClipRenderedText}" />

                            <TextBox IsVisible="{Binding ShowSelectedRichTextRenderer}"
                                     Classes="content-viewer"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     HorizontalContentAlignment="Stretch"
                                     Text="{Binding SelectedClipRenderedText}" />

                            <Grid IsVisible="{Binding ShowSelectedFilesRenderer}"
                                  Margin="18">
                                <Grid RowDefinitions="Auto,*"
                                      RowSpacing="12">
                                    <TextBlock Classes="body-muted"
                                               Text="{Binding SelectedClipRenderedText}" />

                                    <ListBox Grid.Row="1"
                                             Classes="file-list"
                                             ItemsSource="{Binding SelectedClipFiles}"
                                             SelectedItem="{Binding SelectedFileItem, Mode=TwoWay}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ClipFileItemViewModel">
                                                <Border Classes="file-item-row"
                                                        Margin="0,0,0,8"
                                                        Padding="12,10">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                                          ColumnSpacing="10">
                                                        <TextBlock Text="📄"
                                                                   VerticalAlignment="Center" />

                                                        <TextBox Grid.Column="1"
                                                                 Classes="file-path-box"
                                                                 IsReadOnly="True"
                                                                 Text="{Binding FilePath}" />

                                                        <TextBlock Grid.Column="2"
                                                                   Classes="body-muted"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding AvailabilityText}" />

                                                        <Button Grid.Column="3"
                                                                Classes="secondary compact"
                                                                Command="{Binding CopyPathCommand}"
                                                                Content="Copy" />

                                                        <StackPanel Grid.Column="4"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8">
                                                            <Button Classes="secondary compact"
                                                                    Command="{Binding OpenCommand}"
                                                                    IsEnabled="{Binding Exists}"
                                                                    Content="Open" />
                                                            <Button Classes="secondary compact"
                                                                    Command="{Binding OpenContainingFolderCommand}"
                                                                    IsEnabled="{Binding Exists}"
                                                                    Content="Folder" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>

                            <TextBox IsVisible="{Binding ShowSelectedFilesFallback}"
                                     Classes="content-viewer"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     HorizontalContentAlignment="Stretch"
                                     Text="{Binding SelectedClipRawContent}" />

                            <Grid IsVisible="{Binding ShowSelectedImageRenderer}"
                                  Margin="18">
                                <Border Classes="image-placeholder"
                                        IsVisible="{Binding ShowSelectedImagePlaceholder}">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="10"
                                                MaxWidth="420">
                                        <TextBlock Text="🖼"
                                                   FontSize="48"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Classes="panel-title"
                                                   HorizontalAlignment="Center"
                                                   Text="Image clip" />
                                        <TextBlock Classes="body-muted"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding SelectedClipImageHint}" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="image-stage"
                                        IsVisible="{Binding ShowSelectedImagePreview}">
                                    <Image Source="{Binding SelectedClipImagePreview}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="1.3*,1.1*,0.9*,1.7*"
                          ColumnSpacing="10">
                        <Border Classes="detail-stat-card"
                                Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="detail-label"
                                           Text="Source" />
                                <TextBlock Classes="detail-value"
                                           Text="{Binding SelectedClip.SourceApp, TargetNullValue='Unknown source'}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Classes="detail-stat-card"
                                Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="detail-label"
                                           Text="Captured" />
                                <TextBlock Classes="detail-value"
                                           Text="{Binding SelectedClip.CapturedAtDisplay, TargetNullValue='—'}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Classes="detail-stat-card"
                                Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="detail-label"
                                           Text="Size" />
                                <TextBlock Classes="detail-value"
                                           Text="{Binding SelectedClip.ByteSizeDisplay, TargetNullValue='0 bytes'}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3"
                                Classes="detail-stat-card"
                                Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="detail-label"
                                           Text="Sensitivity" />
                                <TextBlock Classes="detail-value"
                                           Text="{Binding SelectedClip.SensitivitySummary, TargetNullValue='No clip selected'}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Classes="inset-panel footer-panel"
                Padding="14,10">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  ColumnSpacing="16">
                <TextBlock Classes="body-muted"
                           Text="{Binding ActiveFilterSummary}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Classes="footer-metric"
                           Text="{Binding MatchingClipCount, StringFormat='Matching {0:N0}'}" />
                <TextBlock Grid.Column="2"
                           Classes="footer-metric"
                           Text="{Binding SensitiveClipCount, StringFormat='Sensitive {0:N0}'}" />
                <TextBlock Grid.Column="3"
                           Classes="body-muted"
                           Text="{Binding LastCaptureSummary}" />
            </Grid>
        </Border>
    </Grid>
</Window>
