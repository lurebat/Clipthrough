<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Clipthrough.Controls"
        xmlns:vm="using:Clipthrough.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1360"
        d:DesignHeight="860"
        x:Class="Clipthrough.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1360"
        Height="860"
        MinWidth="1080"
        MinHeight="700">

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto"
              RowSpacing="6"
              Margin="8">
        <Border Grid.Row="0"
                Classes="hero-toolbar"
                Padding="12,10">
            <Grid ColumnDefinitions="Auto,*,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="10">
                <TextBlock Classes="window-title"
                           VerticalAlignment="Center"
                           Text="{Binding HeroTitle}" />

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Watermark="{Binding SearchWatermark}"
                         Text="{Binding SearchText}" />

                <UniformGrid Grid.Column="2"
                             Columns="5"
                             HorizontalAlignment="Stretch">
                    <RadioButton GroupName="ContentType"
                                 Classes="segmented-left"
                                 IsChecked="{Binding IsAllTypeSelected}"
                                 HorizontalContentAlignment="Center"
                                 Content="All" />
                    <RadioButton GroupName="ContentType"
                                 Classes="segmented-center"
                                 IsChecked="{Binding IsTextTypeSelected}"
                                 HorizontalContentAlignment="Center"
                                 Content="Text" />
                    <RadioButton GroupName="ContentType"
                                 Classes="segmented-center"
                                 IsChecked="{Binding IsImageTypeSelected}"
                                 HorizontalContentAlignment="Center"
                                 Content="Image" />
                    <RadioButton GroupName="ContentType"
                                 Classes="segmented-center"
                                 IsChecked="{Binding IsRichTextTypeSelected}"
                                 HorizontalContentAlignment="Center"
                                 Content="Rich" />
                    <RadioButton GroupName="ContentType"
                                 Classes="segmented-right"
                                 IsChecked="{Binding IsFilesTypeSelected}"
                                 HorizontalContentAlignment="Center"
                                 Content="Files" />
                </UniformGrid>

                <CheckBox Grid.Column="3"
                          Classes="filter-toggle compact-toggle"
                          IsChecked="{Binding ShowFavoritesOnly}"
                          Content="{Binding FavoritesFilterLabel}" />

                <CheckBox Grid.Column="4"
                          Classes="filter-toggle compact-toggle"
                          IsChecked="{Binding ShowSensitiveOnly}"
                          Content="{Binding SensitiveFilterLabel}" />

                <CheckBox Grid.Column="5"
                          Classes="filter-toggle compact-toggle"
                          IsChecked="{Binding UseRegexSearch}"
                          Content="{Binding RegexFilterLabel}" />

                <CheckBox Grid.Column="6"
                          Classes="filter-toggle compact-toggle"
                          IsChecked="{Binding CaseSensitiveSearch}"
                          Content="{Binding CaseSensitiveFilterLabel}" />

                <CheckBox Grid.Column="7"
                          Classes="filter-toggle compact-toggle"
                          IsChecked="{Binding UseWildcardSearch}"
                          Content="{Binding WildcardFilterLabel}" />

                <CheckBox Grid.Column="8"
                          Classes="filter-toggle compact-toggle"
                          IsChecked="{Binding WholeWordSearch}"
                          Content="{Binding WholeWordFilterLabel}" />

                <CheckBox Grid.Column="9"
                          Classes="filter-toggle compact-toggle"
                          IsChecked="{Binding ShowPastedOnly}"
                          Content="{Binding PastedFilterLabel}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="380,6,*"
              ColumnSpacing="4">
            <Border Grid.Column="0"
                    Classes="surface-panel">
                <Grid RowDefinitions="Auto,*,Auto"
                      RowSpacing="10"
                      Margin="12">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="4"
                          HorizontalAlignment="Left">
                        <Button Classes="secondary compact"
                                Command="{Binding SelectAllClipsCommand}"
                                Content="{Binding SelectAllButtonLabel}" />
                        <Button Classes="secondary compact"
                                Grid.Column="1"
                                Command="{Binding SelectNoClipsCommand}"
                                Content="{Binding SelectNoneButtonLabel}" />
                        <Button Classes="secondary compact"
                                 Grid.Column="2"
                                Command="{Binding FavoriteCheckedClipsCommand}"
                                IsEnabled="{Binding HasCheckedOrSelectedClip}"
                                Content="{Binding FavoriteSelectedButtonLabel}" />
                        <Button Classes="destructive compact"
                                Grid.Column="3"
                                Command="{Binding DeleteCheckedClipsCommand}"
                                IsEnabled="{Binding HasCheckedOrSelectedClip}"
                                Content="{Binding DeleteButtonLabel}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <TextBlock Classes="empty-state"
                                    IsVisible="{Binding HasNoClips}"
                                    HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding EmptyListMessage}" />

                        <ListBox x:Name="ClipsListBox"
                                  Classes="clip-list"
                                  ItemsSource="{Binding Clips}"
                                  SelectedItem="{Binding SelectedClip, Mode=TwoWay}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ClipItemViewModel">
                                    <Border Classes="clip-row-card"
                                            Background="{Binding FrequencyBackground}"
                                            BorderBrush="{Binding RowBorderBrush}"
                                            BorderThickness="{Binding RowBorderThickness}"
                                            Padding="10,8">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding CopyLabel}"
                                                          Command="{Binding CopyCommand}" />
                                                <MenuItem Header="Open in editor"
                                                          Command="{Binding #ClipsListBox.DataContext.OpenInEditorCommand}" />
                                                <MenuItem Header="Compare checked clips"
                                                          Command="{Binding #ClipsListBox.DataContext.CompareClipsCommand}" />
                                                <Separator />
                                                <MenuItem Header="{Binding FavoriteActionLabel}"
                                                          Command="{Binding ToggleFavoriteCommand}" />
                                                <MenuItem Header="{Binding ExportLabel}"
                                                          Command="{Binding ExportCommand}" />
                                                <Separator />
                                                <MenuItem Header="Open source URL"
                                                          IsVisible="{Binding HasSourceUrl}"
                                                          Command="{Binding #ClipsListBox.DataContext.OpenSelectedClipSourceUrlCommand}" />
                                                <MenuItem Header="Copy window title"
                                                          IsVisible="{Binding HasSourceWindowTitle}"
                                                          Command="{Binding #ClipsListBox.DataContext.CopySelectedClipWindowTitleCommand}" />
                                                <Separator />
                                                <MenuItem Header="{Binding DeleteLabel}"
                                                          Command="{Binding DeleteCommand}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                                              ColumnSpacing="4">
                                            <CheckBox Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayIndexText}"
                                                       Foreground="{Binding DisplayIndexForeground}"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Width="18"
                                                       TextAlignment="Center" />

                                            <Border Grid.Column="2"
                                                    Classes="clip-row-icon"
                                                    VerticalAlignment="Center">
                                                <Grid>
                                                    <Image Source="{Binding SourceAppIconImage}"
                                                           Width="18"
                                                           Height="18"
                                                           Stretch="Uniform"
                                                           IsVisible="{Binding HasSourceAppIcon}" />
                                                    <TextBlock Text="{Binding TypeGlyph}"
                                                               Foreground="{Binding StateAccentBrush}"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding ShowTypeGlyph}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                <Image Source="{Binding PreviewThumbnailImage}"
                                                       Width="84"
                                                       Height="48"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding ShowPreviewThumbnail}" />
                                                <TextBlock Text="{Binding ThumbnailInfoCompact}"
                                                           Classes="body-muted"
                                                           FontSize="10"
                                                           MaxWidth="160"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding ShowPreviewThumbnail}" />
                                                <TextBlock Classes="clip-row-preview"
                                                           Text="{Binding SingleLinePreview}"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding ShowTextPreview}" />
                                                <WrapPanel Orientation="Horizontal"
                                                           ItemSpacing="4"
                                                           LineSpacing="2">
                                                    <Border Classes="meta-chip"
                                                            Padding="6,1"
                                                            Background="{Binding TypeChipBackground}"
                                                            BorderBrush="{Binding TypeChipBorderBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayContentType}"
                                                                   Foreground="{Binding TypeChipForeground}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Classes="meta-chip"
                                                            Padding="6,1"
                                                            Background="{Binding AgeChipBackground}"
                                                            BorderBrush="{Binding AgeChipBorderBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CapturedAtCompact}"
                                                                   Foreground="{Binding AgeChipForeground}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Classes="meta-chip"
                                                            Padding="6,1"
                                                            Background="{Binding PastedChipBackground}"
                                                            BorderBrush="{Binding PastedChipBorderBrush}"
                                                            IsVisible="{Binding HasBeenPasted}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PastedMarker}"
                                                                   Foreground="{Binding PastedChipForeground}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Classes="clip-row-date"
                                                               Text="{Binding CopyCountCompact}"
                                                               IsVisible="{Binding ShowCopyCountBadge}"
                                                               VerticalAlignment="Center"
                                                               FontSize="10" />
                                                    <TextBlock Text="{Binding FavoriteMarker}"
                                                               Foreground="{Binding StateAccentBrush}"
                                                               IsVisible="{Binding IsFavorite}"
                                                               VerticalAlignment="Center"
                                                               FontSize="10" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.Row="2"
                            Classes="inset-panel"
                            Padding="8,6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <Border Classes="badge-chip"
                                    Background="{DynamicResource StatusChipSelectedBg}"
                                    BorderBrush="{DynamicResource StatusChipSelectedBorder}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding CheckedClipSummaryText}"
                                           Foreground="{DynamicResource StatusChipSelectedFg}" />
                            </Border>
                            <Border Classes="badge-chip"
                                    Background="{DynamicResource StatusChipMatchingBg}"
                                    BorderBrush="{DynamicResource StatusChipMatchingBorder}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding MatchingClipCountText}"
                                           Foreground="{DynamicResource StatusChipMatchingFg}" />
                            </Border>
                            <Border Classes="badge-chip"
                                    Background="{DynamicResource StatusChipSensitiveBg}"
                                    BorderBrush="{DynamicResource StatusChipSensitiveBorder}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SensitiveClipCountText}"
                                           Foreground="{DynamicResource StatusChipSensitiveFg}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Width="6" />

            <Border Grid.Column="2"
                    Classes="surface-panel"
                    MinWidth="480"
                    BorderBrush="{Binding SelectedClipAreaBorderBrush}"
                    BorderThickness="{Binding SelectedClipAreaBorderThickness}">
                <Grid RowDefinitions="Auto,*,Auto"
                      RowSpacing="10"
                      Margin="10">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="panel-caption"
                                       Text="{Binding SelectedClipContentTypeText}" />
                            <TextBlock Classes="panel-title"
                                       Foreground="{Binding SelectedClipAccentBrush}"
                                       Text="{Binding SelectedClipTitleText}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="body-muted"
                                       Text="{Binding SelectionStateTitle}"
                                       IsVisible="{Binding !HasSelectedClip}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <Border Classes="badge-chip"
                                        IsVisible="{Binding ShowSelectedClipSeverityIndicator}"
                                        Background="{Binding SelectedClipSeverityBadgeBackground}"
                                        BorderBrush="{Binding SelectedClipSeverityBadgeBorderBrush}">
                                    <TextBlock Text="{Binding SelectedClipSeverityIndicatorText}"
                                               Foreground="{Binding SelectedClipSeverityBadgeForeground}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <WrapPanel Grid.Column="1"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   ItemSpacing="8"
                                   LineSpacing="6">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="0"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding IsDisplayModeApplicable}">
                                <RadioButton GroupName="DisplayMode"
                                             Classes="segmented-left"
                                             IsChecked="{Binding IsRenderedMode}"
                                             Content="Rendered" />
                                <RadioButton GroupName="DisplayMode"
                                             Classes="segmented-center"
                                             IsChecked="{Binding IsTextualMode}"
                                             Content="Textual" />
                                <RadioButton GroupName="DisplayMode"
                                             Classes="segmented-right"
                                             IsChecked="{Binding IsRawMode}"
                                             Content="Raw" />
                            </StackPanel>

                            <Button Classes="secondary compact"
                                    Command="{Binding CopySelectedCommand}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    Content="{Binding CopyButtonLabel}" />

                            <Button Classes="secondary compact"
                                    Command="{Binding ExportSelectedCommand}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    Content="{Binding ExportButtonLabel}" />

                            <Button Classes="secondary compact"
                                    Command="{Binding OpenInEditorCommand}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    Content="{Binding OpenInEditorButtonLabel}" />

                            <Button Classes="secondary compact"
                                    Command="{Binding CompareClipsCommand}"
                                    IsEnabled="{Binding IsCompareAvailable}"
                                    Content="{Binding CompareClipsButtonLabel}" />

                            <Button Classes="secondary compact"
                                    Command="{Binding CopyEditedClipCommand}"
                                    IsEnabled="{Binding ShowCopyEditedClipButton}"
                                    IsVisible="{Binding !ShowSelectedImageEditor}"
                                    Content="{Binding CopyAsNewButtonLabel}" />

                            <Button Classes="secondary compact"
                                    Click="OnCopyEditedImageClick"
                                    IsVisible="{Binding ShowSelectedImageEditor}"
                                    Content="{Binding CopyAsNewButtonLabel}" />

                            <Button Classes="secondary compact"
                                    Click="OnResetEditedImageClick"
                                    IsVisible="{Binding ShowSelectedImageEditor}"
                                    Content="{Binding ResetImageEditsButtonLabel}" />

                            <Button Classes="secondary compact favorite-toggle"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    Classes.active="{Binding IsSelectedClipFavorite}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    Content="{Binding SelectedClipFavoriteButtonLabel}" />

                            <Button Classes="destructive compact"
                                    Command="{Binding DeleteSelectedCommand}"
                                    IsEnabled="{Binding HasSelectedClip}"
                                    Content="{Binding DeleteButtonLabel}" />
                        </WrapPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Classes="content-stage"
                            ClipToBounds="True"
                            BorderBrush="{Binding SelectedClipAreaBorderBrush}"
                            BorderThickness="{Binding SelectedClipAreaBorderThickness}">
                        <Grid>
                            <ComboBox ItemsSource="{Binding TextTransformationOptions}"
                                      SelectedItem="{Binding SelectedTextTransformation, Mode=TwoWay}"
                                      IsVisible="{Binding IsSelectedClipTextEditable}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Margin="0,6,10,0"
                                      Width="180"
                                      ZIndex="10"
                                      ToolTip.Tip="Apply text transformation" />
                            <StackPanel IsVisible="{Binding ShowEmptySelectionState}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10"
                                        MaxWidth="420">
                                <TextBlock Text="📋"
                                           FontSize="44"
                                           HorizontalAlignment="Center" />
                                <TextBlock Classes="panel-title"
                                           HorizontalAlignment="Center"
                                           Text="{Binding EmptySelectionTitleText}" />
                                <TextBlock Classes="body-muted"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="{Binding EmptySelectionDescriptionText}" />
                            </StackPanel>

                            <controls:SyntaxTextEditor IsVisible="{Binding ShowRawTextContent}"
                                      IsReadOnly="{Binding SelectedClipTextIsReadOnly}"
                                      SyntaxHint="{Binding RawContentSyntaxHint}"
                                      Text="{Binding EditedClipText, Mode=TwoWay}" />

                            <controls:SyntaxTextEditor IsVisible="{Binding ShowSelectedTextRenderer}"
                                      IsReadOnly="{Binding SelectedClipTextIsReadOnly}"
                                      Text="{Binding EditedClipText, Mode=TwoWay}" />

                            <controls:RichContentView IsVisible="{Binding ShowSelectedRichTextRenderer}"
                                                       Markup="{Binding EditedClipText, Mode=OneWay}"
                                                       ContentFormat="{Binding SelectedClipContentFormat}" />

                            <Grid IsVisible="{Binding ShowSelectedFilesRenderer}"
                                  Margin="14">
                                <Grid RowDefinitions="Auto,*"
                                      RowSpacing="12">
                                    <TextBlock Classes="body-muted"
                                               Text="{Binding SelectedClipRenderedText}" />

                                    <ListBox Grid.Row="1"
                                             Classes="file-list"
                                             ItemsSource="{Binding SelectedClipFiles}"
                                             SelectedItem="{Binding SelectedFileItem, Mode=TwoWay}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ClipFileItemViewModel">
                                                <Border Classes="file-item-row"
                                                        Margin="0,0,0,8"
                                                        Padding="12,10">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                                          ColumnSpacing="10">
                                                        <TextBlock Text="📄"
                                                                   VerticalAlignment="Center" />

                                                        <TextBox Grid.Column="1"
                                                                 Classes="file-path-box"
                                                                 IsReadOnly="True"
                                                                 Text="{Binding FilePath}" />

                                                        <TextBlock Grid.Column="2"
                                                                   Classes="body-muted"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding AvailabilityText}" />

                                                        <Button Grid.Column="3"
                                                                Classes="secondary compact"
                                                                Command="{Binding CopyPathCommand}"
                                                                Content="{Binding CopyLabel}" />

                                                        <StackPanel Grid.Column="4"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8">
                                                            <Button Classes="secondary compact"
                                                                    Command="{Binding OpenCommand}"
                                                                    IsEnabled="{Binding Exists}"
                                                                    Content="{Binding OpenLabel}" />
                                                            <Button Classes="secondary compact"
                                                                    Command="{Binding OpenContainingFolderCommand}"
                                                                    IsEnabled="{Binding Exists}"
                                                                    Content="{Binding FolderLabel}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>

                            <TextBox IsVisible="{Binding ShowSelectedFilesFallback}"
                                     Classes="content-viewer"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     HorizontalContentAlignment="Stretch"
                                     Text="{Binding SelectedClipRawContent}" />

                            <Grid IsVisible="{Binding ShowSelectedImageRenderer}"
                                  Margin="14"
                                  RowDefinitions="*,Auto"
                                  RowSpacing="10">
                                <Border Classes="image-placeholder"
                                         Grid.RowSpan="1"
                                         IsVisible="{Binding ShowSelectedImagePlaceholder}">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="10"
                                                MaxWidth="420">
                                        <TextBlock Text="🖼"
                                                   FontSize="48"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Classes="panel-title"
                                                   HorizontalAlignment="Center"
                                                   Text="{Binding SelectedImageTypeText}" />
                                        <TextBlock Classes="body-muted"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding SelectedClipImageHint}" />
                                    </StackPanel>
                                </Border>

                                <controls:EmbeddedImageEditorView Grid.Row="0"
                                                                  x:Name="SelectedImageEditor"
                                                                  IsVisible="{Binding ShowSelectedImageEditor}"
                                                                  MinHeight="450"
                                                                  SourceImageBytes="{Binding SelectedClipImageBytes}" />

                                <TextBlock Grid.Row="1"
                                           Classes="body-muted"
                                           HorizontalAlignment="Center"
                                           Text="{Binding SelectedClipImageResolutionText}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Classes="inset-panel"
                            Padding="10,6">
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="6"
                                   LineSpacing="4">
                            <Border Classes="meta-chip"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4">
                                    <Image Source="{Binding SelectedClipSourceAppIcon}"
                                           Width="14"
                                           Height="14"
                                           Stretch="Uniform"
                                           IsVisible="{Binding ShowSelectedClipSourceAppIcon}" />
                                    <TextBlock Classes="body-muted"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Text="{Binding SelectedClipSourceText}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="meta-chip"
                                    Padding="8,2"
                                    IsVisible="{Binding ShowSelectedClipWindowTitle}"
                                    VerticalAlignment="Center">
                                <TextBlock Classes="body-muted"
                                           FontSize="11"
                                           MaxWidth="260"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Text="{Binding SelectedClipWindowTitleText}" />
                            </Border>
                            <Border Padding="8,2"
                                    CornerRadius="999"
                                    BorderThickness="1"
                                    Background="{Binding SelectedClipPastedChipBackground}"
                                    BorderBrush="{Binding SelectedClipPastedChipBorderBrush}"
                                    IsVisible="{Binding ShowSelectedClipPasted}"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding SelectedClipPastedChipForeground}"
                                           Text="{Binding SelectedClipPastedText}" />
                            </Border>
                            <Border Padding="8,2"
                                    CornerRadius="999"
                                    BorderThickness="1"
                                    Background="{Binding SelectedClipTypeChipBackground}"
                                    BorderBrush="{Binding SelectedClipTypeChipBorderBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding SelectedClipTypeChipForeground}"
                                           Text="{Binding SelectedClipContentTypeText}" />
                            </Border>
                            <Border Padding="8,2"
                                    CornerRadius="999"
                                    BorderThickness="1"
                                    Background="{Binding SelectedClipAgeChipBackground}"
                                    BorderBrush="{Binding SelectedClipAgeChipBorderBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding SelectedClipAgeChipForeground}"
                                           Text="{Binding SelectedClipFirstCopiedAtText}" />
                            </Border>
                            <Border Classes="meta-chip"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Classes="body-muted"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Text="{Binding SelectedClipCapturedAtText}" />
                            </Border>
                            <Border Classes="meta-chip"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Classes="body-muted"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Text="{Binding SelectedClipExpiresAtText}" />
                            </Border>
                            <Border Classes="meta-chip"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Classes="body-muted"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Text="{Binding SelectedClipCopyCountText}" />
                            </Border>
                            <Border Padding="8,2"
                                    CornerRadius="999"
                                    BorderThickness="1"
                                    Background="{Binding SelectedClipSizeChipBackground}"
                                    BorderBrush="{Binding SelectedClipSizeChipBorderBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding SelectedClipSizeChipForeground}"
                                           Text="{Binding SelectedClipByteSizeText}" />
                            </Border>
                            <Border Classes="meta-chip"
                                    Padding="8,2"
                                    IsVisible="{Binding ShowSelectedImageResolutionCard}"
                                    VerticalAlignment="Center">
                                <TextBlock Classes="body-muted"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Text="{Binding SelectedClipImageResolutionText}" />
                            </Border>
                            <Border Padding="8,2"
                                    CornerRadius="999"
                                    BorderThickness="1"
                                    Background="{Binding SelectedClipSensitivityChipBackground}"
                                    BorderBrush="{Binding SelectedClipSensitivityChipBorderBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding SelectedClipSensitivityChipForeground}"
                                           Text="{Binding SelectedClipSensitivityText}" />
                            </Border>
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Classes="inset-panel footer-panel"
                Padding="12,6">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="14"
                  VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock Classes="body-muted"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="300"
                               Text="{Binding ActiveFilterSummary}" />
                    <Border Classes="badge-chip"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding LastCaptureSummary}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Classes="detail-stat-card"
                            Padding="8,4"
                            MinWidth="280">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <TextBlock Classes="detail-label"
                                           FontSize="10"
                                           Text="{Binding StorageUsageText}" />
                                <TextBlock Grid.Column="1"
                                           Classes="body-muted"
                                           FontSize="10"
                                           Text="{Binding StorageCapacityText}" />
                            </Grid>
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding StorageUsagePercent}"
                                         Height="4" />
                        </StackPanel>
                    </Border>

                    <Border Classes="detail-stat-card"
                            Padding="8,4"
                            MinWidth="280">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <TextBlock Classes="detail-label"
                                           FontSize="10"
                                           Text="{Binding EntryUsageText}" />
                                <TextBlock Grid.Column="1"
                                           Classes="body-muted"
                                           FontSize="10"
                                           Text="{Binding EntryCapacityText}" />
                            </Grid>
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding EntryUsagePercent}"
                                         Height="4" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="secondary compact"
                            Command="{Binding SessionLogs.OpenCommand}"
                            Content="{Binding LogsButtonLabel}" />
                    <Button Classes="secondary compact"
                            Command="{Binding OpenSettingsCommand}"
                            Content="{Binding SettingsButtonLabel}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.RowSpan="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,16,16,0"
                IsHitTestVisible="True">
            <ItemsControl ItemsSource="{Binding Notifications}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppNotificationViewModel">
                        <Border Background="{Binding Background}"
                                BorderBrush="{Binding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,8"
                                Width="360"
                                IsHitTestVisible="True">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12">
                                    <TextBlock Classes="detail-label"
                                               Text="{Binding Title}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="body-muted"
                                               Text="{Binding TimestampText}" />
                                 </Grid>
                                 <TextBlock Text="{Binding Message}"
                                            TextWrapping="Wrap" />
                                 <ItemsControl ItemsSource="{Binding Actions}"
                                               IsVisible="{Binding HasActions}">
                                     <ItemsControl.ItemsPanel>
                                         <ItemsPanelTemplate>
                                             <StackPanel Orientation="Horizontal"
                                                         Spacing="8" />
                                         </ItemsPanelTemplate>
                                     </ItemsControl.ItemsPanel>
                                     <ItemsControl.ItemTemplate>
                                         <DataTemplate x:DataType="vm:AppNotificationActionViewModel">
                                             <Button Classes="secondary compact"
                                                     Command="{Binding ExecuteCommand}"
                                                     Content="{Binding Label}" />
                                         </DataTemplate>
                                     </ItemsControl.ItemTemplate>
                                 </ItemsControl>
                             </StackPanel>
                         </Border>
                     </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Grid.RowSpan="3"
                Classes="settings-backdrop"
                IsVisible="{Binding IsSettingsOpen}">
            <Border Classes="surface-panel settings-sheet"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     MaxWidth="1240"
                     MinWidth="960"
                     Padding="22">
                <Grid RowDefinitions="Auto,Auto,*,Auto"
                      RowSpacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="panel-title"
                                   Text="{Binding SettingsTitleText}" />
                        <TextBlock Classes="body-muted"
                                   Text="{Binding SettingsDescriptionText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Classes="body-muted"
                               Text="{Binding SettingsHintText}"
                               TextWrapping="Wrap" />

                    <ScrollViewer Grid.Row="2"
                                  MaxHeight="620"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="14">
                            <Border Classes="inset-panel"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="panel-caption"
                                               Text="{Binding SettingsBehaviorTitle}" />
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="detail-label"
                                                   Text="{Binding SettingsThemeModeLabel}" />
                                        <ComboBox ItemsSource="{Binding ThemeModeOptions}"
                                                  SelectedItem="{Binding SettingsThemeMode}" />
                                    </StackPanel>
                                    <CheckBox Content="{Binding SettingsCloseToTrayLabel}"
                                              IsChecked="{Binding SettingsCloseToTray}" />
                                    <CheckBox Content="{Binding SettingsMinimizeToTrayLabel}"
                                              IsChecked="{Binding SettingsMinimizeToTray}" />
                                    <CheckBox Content="{Binding SettingsStartWithWindowsLabel}"
                                              IsChecked="{Binding SettingsStartWithWindows}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="inset-panel"
                                    Padding="16">
                                <StackPanel Spacing="14">
                                    <TextBlock Classes="panel-caption"
                                               Text="{Binding SettingsLocalHotkeysTitle}" />

                                    <Grid ColumnDefinitions="Auto,260,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                          ColumnSpacing="12"
                                          RowSpacing="10">
                                        <CheckBox Content="{Binding SettingsEnableShortcutLabel}"
                                                  IsChecked="{Binding SettingsEnableToggleRegexHotkey}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsRegexHotkeyLabel}" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding SettingsToggleRegexHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <CheckBox Grid.Row="1"
                                                  Content="{Binding SettingsEnableShortcutLabel}"
                                                  IsChecked="{Binding SettingsEnableToggleFavoritesHotkey}" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsFavoritesHotkeyLabel}" />
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="2"
                                                 Text="{Binding SettingsToggleFavoritesHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <CheckBox Grid.Row="2"
                                                  Content="{Binding SettingsEnableShortcutLabel}"
                                                  IsChecked="{Binding SettingsEnableToggleSensitiveHotkey}" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsSensitiveHotkeyLabel}" />
                                        <TextBox Grid.Row="2"
                                                 Grid.Column="2"
                                                 Text="{Binding SettingsToggleSensitiveHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <CheckBox Grid.Row="3"
                                                  Content="{Binding SettingsEnableShortcutLabel}"
                                                  IsChecked="{Binding SettingsEnableToggleCaseSensitiveHotkey}" />
                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsCaseSensitiveHotkeyLabel}" />
                                        <TextBox Grid.Row="3"
                                                 Grid.Column="2"
                                                 Text="{Binding SettingsToggleCaseSensitiveHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <CheckBox Grid.Row="4"
                                                  Content="{Binding SettingsEnableShortcutLabel}"
                                                  IsChecked="{Binding SettingsEnableToggleWildcardHotkey}" />
                                        <TextBlock Grid.Row="4"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsWildcardHotkeyLabel}" />
                                        <TextBox Grid.Row="4"
                                                 Grid.Column="2"
                                                 Text="{Binding SettingsToggleWildcardHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <CheckBox Grid.Row="5"
                                                  Content="{Binding SettingsEnableShortcutLabel}"
                                                  IsChecked="{Binding SettingsEnableToggleWholeWordHotkey}" />
                                        <TextBlock Grid.Row="5"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsWholeWordHotkeyLabel}" />
                                        <TextBox Grid.Row="5"
                                                 Grid.Column="2"
                                                 Text="{Binding SettingsToggleWholeWordHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <CheckBox Grid.Row="6"
                                                  Content="{Binding SettingsEnableShortcutLabel}"
                                                  IsChecked="{Binding SettingsEnableTogglePastedHotkey}" />
                                        <TextBlock Grid.Row="6"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsPastedHotkeyLabel}" />
                                        <TextBox Grid.Row="6"
                                                 Grid.Column="2"
                                                 Text="{Binding SettingsTogglePastedHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="inset-panel"
                                    Padding="16">
                                <StackPanel Spacing="14">
                                    <TextBlock Classes="panel-caption"
                                               Text="{Binding SettingsGlobalHotkeyTitle}" />

                                    <Grid ColumnDefinitions="Auto,260,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto"
                                          ColumnSpacing="12"
                                          RowSpacing="10">
                                        <CheckBox Content="{Binding SettingsEnableShortcutLabel}"
                                                  IsChecked="{Binding SettingsEnableToggleWindowHotkey}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsToggleWindowHotkeyLabel}" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding SettingsToggleWindowHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsClipLimitLabel}" />
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="2"
                                                 Text="{Binding SettingsMaxClipSizeKilobytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <CheckBox Grid.Row="2"
                                                  Content="{Binding SettingsEnableShortcutLabel}"
                                                  IsChecked="{Binding SettingsEnableIncrementalPasteHotkey}" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsIncrementalPasteHotkeyLabel}" />
                                        <TextBox Grid.Row="2"
                                                 Grid.Column="2"
                                                 Text="{Binding SettingsIncrementalPasteHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <CheckBox Grid.Row="3"
                                                  Content="{Binding SettingsEnableShortcutLabel}"
                                                  IsChecked="{Binding SettingsEnableDecrementalPasteHotkey}" />
                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsDecrementalPasteHotkeyLabel}" />
                                        <TextBox Grid.Row="3"
                                                 Grid.Column="2"
                                                 Text="{Binding SettingsDecrementalPasteHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="inset-panel"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="panel-caption"
                                               Text="{Binding SettingsStorageTitle}" />

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="detail-label"
                                                   Text="{Binding SettingsDatabasePathLabel}" />
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8">
                                            <TextBox Text="{Binding SettingsDatabasePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="1"
                                                    Classes="secondary compact"
                                                    Command="{Binding BrowseDatabasePathCommand}"
                                                    CommandParameter="{Binding $parent[Window]}"
                                                    Content="{Binding SettingsBrowseDatabasePathButtonLabel}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="detail-label"
                                                   Text="{Binding SettingsDatabasePasswordLabel}" />
                                        <TextBox Text="{Binding SettingsDatabasePassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PasswordChar="*"
                                                 RevealPassword="{Binding IsDatabasePasswordVisible}" />
                                        <CheckBox Content="{Binding SettingsShowPasswordLabel}"
                                                  IsChecked="{Binding IsDatabasePasswordVisible}" />
                                    </StackPanel>

                                    <TextBlock Classes="body-muted"
                                               Text="{Binding SettingsStorageHintText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Classes="inset-panel"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="panel-caption"
                                               Text="{Binding SettingsToolsTitle}" />

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="detail-label"
                                                   Text="{Binding SettingsExternalEditorPathLabel}" />
                                        <TextBox Text="{Binding SettingsExternalEditorPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="detail-label"
                                                   Text="{Binding SettingsExternalDiffToolPathLabel}" />
                                        <TextBox Text="{Binding SettingsExternalDiffToolPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="inset-panel"
                                    Padding="16">
                                <StackPanel Spacing="14">
                                    <TextBlock Classes="panel-caption"
                                               Text="{Binding SettingsRetentionTitle}" />
                                    <Grid ColumnDefinitions="Auto,260,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto"
                                          ColumnSpacing="12"
                                          RowSpacing="10">
                                        <CheckBox Content="{Binding SettingsEnableShortcutLabel}"
                                                  IsChecked="{Binding SettingsEnableNormalClipLifetime}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsNormalClipLifetimeLabel}" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding SettingsNormalClipLifetimeDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <CheckBox Grid.Row="1"
                                                  Content="{Binding SettingsEnableShortcutLabel}"
                                                  IsChecked="{Binding SettingsEnableSensitiveClipLifetime}" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsSensitiveClipLifetimeLabel}" />
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="2"
                                                 Text="{Binding SettingsSensitiveClipLifetimeMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="inset-panel"
                                    Padding="16">
                                <StackPanel Spacing="14">
                                    <TextBlock Classes="panel-caption"
                                               Text="{Binding SettingsCapacityTitle}" />
                                    <Grid ColumnDefinitions="Auto,260,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto"
                                          ColumnSpacing="12"
                                          RowSpacing="10">
                                        <CheckBox Content="{Binding SettingsEnableShortcutLabel}"
                                                  IsChecked="{Binding SettingsEnableMaxLibrarySize}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsMaxLibrarySizeLabel}" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding SettingsMaxLibrarySizeMegabytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <CheckBox Grid.Row="1"
                                                  Content="{Binding SettingsEnableShortcutLabel}"
                                                  IsChecked="{Binding SettingsEnableMaxEntryCount}" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsMaxEntryCountLabel}" />
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="2"
                                                 Text="{Binding SettingsMaxEntryCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="inset-panel"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="panel-caption"
                                                   Text="{Binding SettingsSensitivityTitle}" />
                                        <Button Grid.Column="1"
                                                Classes="secondary compact"
                                                Command="{Binding AddSensitivityRuleCommand}"
                                                Content="{Binding SettingsAddRuleButtonLabel}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding SensitivityRules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SensitivityRuleEditorViewModel">
                                                <Expander IsExpanded="{Binding IsExpanded}">
                                                    <Expander.Header>
                                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                                              ColumnSpacing="8">
                                                            <TextBlock Text="{Binding HeaderText}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Classes="body-muted"
                                                                       Text="{Binding SummaryText}" />
                                                            <Button Grid.Column="2"
                                                                    Classes="destructive compact"
                                                                    IsVisible="{Binding CanRemove}"
                                                                    Command="{Binding RemoveCommand}"
                                                                    Content="{Binding $parent[Window].DataContext.DeleteButtonLabel}" />
                                                        </Grid>
                                                    </Expander.Header>
                                                    <Grid ColumnDefinitions="*,*"
                                                          ColumnSpacing="10"
                                                          RowDefinitions="Auto,Auto,Auto">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Classes="detail-label"
                                                                       Text="{Binding $parent[Window].DataContext.SettingsRuleNameLabel}" />
                                                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1"
                                                                    Spacing="4">
                                                            <TextBlock Classes="detail-label"
                                                                       Text="{Binding $parent[Window].DataContext.SettingsRuleSeverityLabel}" />
                                                            <ComboBox ItemsSource="{Binding $parent[Window].DataContext.SensitivitySeverityOptions}"
                                                                      SelectedItem="{Binding Severity}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1"
                                                                    Grid.ColumnSpan="2"
                                                                    Spacing="4">
                                                            <TextBlock Classes="detail-label"
                                                                       Text="{Binding $parent[Window].DataContext.SettingsRulePatternLabel}" />
                                                            <TextBox Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <CheckBox Grid.Row="2"
                                                                  Content="{Binding $parent[Window].DataContext.SettingsRuleEnabledLabel}"
                                                                  IsChecked="{Binding IsEnabled}" />
                                                    </Grid>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right">
                        <Button Classes="secondary compact"
                                Command="{Binding CloseSettingsCommand}"
                                Content="{Binding SettingsCancelButtonLabel}" />
                        <Button Classes="primary compact"
                                Command="{Binding SaveSettingsCommand}"
                                Content="{Binding SettingsSaveButtonLabel}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        </Grid>

        <Border IsVisible="{Binding IsWelcomeOpen}"
                Margin="10"
                Classes="hero-surface"
                Padding="28">
            <Grid RowDefinitions="Auto,*,Auto"
                  RowSpacing="18">
                <StackPanel Spacing="8">
                    <TextBlock Classes="eyebrow"
                               Text="{Binding WindowTitle}" />
                    <TextBlock Classes="hero-title"
                               Text="{Binding WelcomeTitleText}" />
                    <TextBlock Classes="body-muted"
                               MaxWidth="760"
                               Text="{Binding WelcomeDescriptionText}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid ColumnDefinitions="340,*"
                          ColumnSpacing="24">
                        <StackPanel Spacing="14">
                            <Border Classes="surface-panel"
                                    Padding="18">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="panel-caption"
                                               Text="{Binding SettingsStorageTitle}" />
                                    <TextBlock Text="{Binding SettingsStorageHintText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Classes="surface-panel"
                                    Padding="18">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="panel-caption"
                                               Text="{Binding SettingsGlobalHotkeyTitle}" />
                                    <TextBlock Text="{Binding SettingsHintText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="14">
                            <Border Classes="surface-panel"
                                    Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="panel-caption"
                                               Text="{Binding SettingsStorageTitle}" />

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="detail-label"
                                                   Text="{Binding SettingsDatabasePathLabel}" />
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8">
                                            <TextBox x:Name="WelcomeDatabasePathTextBox"
                                                     Text="{Binding SettingsDatabasePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button x:Name="WelcomeDatabasePathBrowseButton"
                                                    Grid.Column="1"
                                                    Classes="secondary compact"
                                                    Command="{Binding BrowseDatabasePathCommand}"
                                                    CommandParameter="{Binding $parent[Window]}"
                                                    Content="{Binding SettingsBrowseDatabasePathButtonLabel}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="detail-label"
                                                   Text="{Binding SettingsDatabasePasswordLabel}" />
                                        <TextBox x:Name="WelcomeDatabasePasswordTextBox"
                                                 Text="{Binding SettingsDatabasePassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PasswordChar="*"
                                                 RevealPassword="{Binding IsDatabasePasswordVisible}" />
                                        <CheckBox Content="{Binding SettingsShowPasswordLabel}"
                                                  IsChecked="{Binding IsDatabasePasswordVisible}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="surface-panel"
                                    Padding="18">
                                <StackPanel Spacing="14">
                                    <TextBlock Classes="panel-caption"
                                               Text="{Binding SettingsGlobalHotkeyTitle}" />
                                    <Grid ColumnDefinitions="Auto,260,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto"
                                          ColumnSpacing="12"
                                          RowSpacing="10">
                                        <CheckBox Content="{Binding SettingsEnableShortcutLabel}"
                                                  IsChecked="{Binding SettingsEnableToggleWindowHotkey}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsToggleWindowHotkeyLabel}" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding SettingsToggleWindowHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SettingsClipLimitLabel}" />
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="2"
                                                 Text="{Binding SettingsMaxClipSizeKilobytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="surface-panel"
                                    Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="panel-caption"
                                               Text="{Binding SettingsBehaviorTitle}" />
                                    <CheckBox Content="{Binding SettingsCloseToTrayLabel}"
                                              IsChecked="{Binding SettingsCloseToTray}" />
                                    <CheckBox Content="{Binding SettingsMinimizeToTrayLabel}"
                                              IsChecked="{Binding SettingsMinimizeToTray}" />
                                    <CheckBox Content="{Binding SettingsStartWithWindowsLabel}"
                                              IsChecked="{Binding SettingsStartWithWindows}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Grid Grid.Row="2"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="16">
                    <TextBlock Classes="body-muted"
                               VerticalAlignment="Center"
                               Text="{Binding StatusText}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Classes="primary"
                            Command="{Binding SaveSettingsCommand}"
                            Content="{Binding WelcomeSaveButtonLabel}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Password Prompt Panel -->
        <Border IsVisible="{Binding IsPasswordPromptOpen}"
                Margin="10"
                Classes="hero-surface"
                Padding="28">
            <Grid RowDefinitions="Auto,*,Auto"
                  RowSpacing="18"
                  MaxWidth="480"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <StackPanel Spacing="8">
                    <TextBlock Classes="eyebrow"
                               Text="{Binding WindowTitle}" />
                    <TextBlock Classes="hero-title"
                               Text="Enter Database Password" />
                    <TextBlock Classes="body-muted"
                               Text="Your clipboard database is encrypted. Enter the password to unlock it."
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Spacing="14"
                            VerticalAlignment="Center">
                    <Border Classes="surface-panel"
                            Padding="18">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="detail-label"
                                           Text="Password" />
                                <TextBox Text="{Binding PasswordPromptInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PasswordChar="*"
                                         RevealPassword="{Binding IsPasswordPromptPasswordVisible}"
                                         Watermark="Enter your database password" />
                                <CheckBox Content="Show password"
                                          IsChecked="{Binding IsPasswordPromptPasswordVisible}" />
                            </StackPanel>

                            <TextBlock Text="{Binding PasswordPromptError}"
                                       IsVisible="{Binding PasswordPromptError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2"
                      ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="12">
                    <Button Classes="secondary"
                            Command="{Binding ExitApplicationCommand}"
                            Content="Exit" />
                    <Button Grid.Column="2"
                            Classes="primary"
                            Command="{Binding UnlockDatabaseCommand}"
                            Content="Unlock" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
