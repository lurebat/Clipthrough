<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Clipthrough.ViewModels"
        xmlns:ctrl="using:Clipthrough.Controls"
        x:Class="Clipthrough.Views.SettingsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding SettingsTitleText}"
        Width="960"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        Background="{DynamicResource AppBackgroundBrush}"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto"
          RowSpacing="12"
          Margin="16">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     PlaceholderText="Filter settings (e.g. hotkey, theme, database)…"
                     Text="{Binding SettingsFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Grid.Column="1"
                      VerticalAlignment="Center"
                      IsChecked="{Binding SettingsUseFuzzySearch}"
                      ToolTip.Tip="Fuzzy: match synonyms (e.g. 'keybind' → 'hotkey') and tolerate typos"
                      Content="Fuzzy" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">
                <!-- Behavior -->
                <Expander Classes="settings-section" IsVisible="{Binding IsSettingsSectionBehaviorVisible}"
                          IsExpanded="{Binding IsSettingsSectionBehaviorExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <TextBlock Text="{Binding SettingsBehaviorTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="12"
                                Margin="8,10,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="detail-label"
                                       Text="{Binding SettingsThemeModeLabel}" />
                            <ComboBox ItemsSource="{Binding ThemeModeOptions}"
                                      SelectedItem="{Binding SettingsThemeMode}" />
                        </StackPanel>
                        <CheckBox Content="{Binding SettingsCloseToTrayLabel}"
                                  IsChecked="{Binding SettingsCloseToTray}" />
                        <CheckBox Content="{Binding SettingsMinimizeToTrayLabel}"
                                  IsChecked="{Binding SettingsMinimizeToTray}" />
                        <CheckBox Content="{Binding SettingsStartWithWindowsLabel}"
                                  IsChecked="{Binding SettingsStartWithWindows}" />
                    </StackPanel>
                </Expander>

                <!-- Local hotkeys -->
                <Expander Classes="settings-section" IsVisible="{Binding IsSettingsSectionLocalHotkeysVisible}"
                          IsExpanded="{Binding IsSettingsSectionLocalHotkeysExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <TextBlock Text="{Binding SettingsLocalHotkeysTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                    </Expander.Header>
                    <Grid ColumnDefinitions="Auto,260,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="10"
                          Margin="8,10,0,0">
                        <CheckBox Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableToggleRegexHotkey}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsRegexHotkeyLabel}" />
                        <ctrl:HotkeyBox Grid.Column="2" Hotkey="{Binding SettingsToggleRegexHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="1" Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableToggleFavoritesHotkey}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsFavoritesHotkeyLabel}" />
                        <ctrl:HotkeyBox Grid.Row="1" Grid.Column="2" Hotkey="{Binding SettingsToggleFavoritesHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="2" Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableToggleSensitiveHotkey}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsSensitiveHotkeyLabel}" />
                        <ctrl:HotkeyBox Grid.Row="2" Grid.Column="2" Hotkey="{Binding SettingsToggleSensitiveHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="3" Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableToggleCaseSensitiveHotkey}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsCaseSensitiveHotkeyLabel}" />
                        <ctrl:HotkeyBox Grid.Row="3" Grid.Column="2" Hotkey="{Binding SettingsToggleCaseSensitiveHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="4" Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableToggleWildcardHotkey}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsWildcardHotkeyLabel}" />
                        <ctrl:HotkeyBox Grid.Row="4" Grid.Column="2" Hotkey="{Binding SettingsToggleWildcardHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="5" Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableToggleWholeWordHotkey}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsWholeWordHotkeyLabel}" />
                        <ctrl:HotkeyBox Grid.Row="5" Grid.Column="2" Hotkey="{Binding SettingsToggleWholeWordHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="6" Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableTogglePastedHotkey}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsPastedHotkeyLabel}" />
                        <ctrl:HotkeyBox Grid.Row="6" Grid.Column="2" Hotkey="{Binding SettingsTogglePastedHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="7" Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableToggleFuzzyHotkey}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" VerticalAlignment="Center"
                                   Text="Toggle fuzzy search" />
                        <ctrl:HotkeyBox Grid.Row="7" Grid.Column="2" Hotkey="{Binding SettingsToggleFuzzyHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="8" Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableToggleSemanticHotkey}" />
                        <TextBlock Grid.Row="8" Grid.Column="1" VerticalAlignment="Center"
                                   Text="Toggle semantic search" />
                        <ctrl:HotkeyBox Grid.Row="8" Grid.Column="2" Hotkey="{Binding SettingsToggleSemanticHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Expander>

                <!-- Global hotkey + paste-sized hotkeys -->
                <Expander Classes="settings-section" IsVisible="{Binding IsSettingsSectionGlobalHotkeyVisible}"
                          IsExpanded="{Binding IsSettingsSectionGlobalHotkeyExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <TextBlock Text="{Binding SettingsGlobalHotkeyTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="10" Margin="8,10,0,0">
                        <TextBlock Classes="body-muted"
                                   TextWrapping="Wrap"
                                   Text="Global hotkeys work from anywhere on the desktop. Incremental paste cycles backward through your clipboard history — press once to paste the previous clip, press again for the one before that, and so on. Decremental paste cycles the other way. Clipthrough puts the clip on the clipboard and synthesizes Ctrl+V into the currently-focused window, so make sure the target window has focus when you press the hotkey." />
                        <Grid ColumnDefinitions="Auto,260,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="10">
                        <CheckBox Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableToggleWindowHotkey}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsToggleWindowHotkeyLabel}" />
                        <ctrl:HotkeyBox Grid.Column="2" Hotkey="{Binding SettingsToggleWindowHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="1" Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableIncrementalPasteHotkey}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsIncrementalPasteHotkeyLabel}" />
                        <ctrl:HotkeyBox Grid.Row="1" Grid.Column="2" Hotkey="{Binding SettingsIncrementalPasteHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="2" Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableDecrementalPasteHotkey}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsDecrementalPasteHotkeyLabel}" />
                        <ctrl:HotkeyBox Grid.Row="2" Grid.Column="2" Hotkey="{Binding SettingsDecrementalPasteHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="3" Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableCopyAndFavoriteHotkey}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsCopyAndFavoriteHotkeyLabel}" />
                        <ctrl:HotkeyBox Grid.Row="3" Grid.Column="2" Hotkey="{Binding SettingsCopyAndFavoriteHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="4" Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableCopyAndSensitiveHotkey}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsCopyAndSensitiveHotkeyLabel}" />
                        <ctrl:HotkeyBox Grid.Row="4" Grid.Column="2" Hotkey="{Binding SettingsCopyAndSensitiveHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="5" Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableCopyWithoutSavingHotkey}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsCopyWithoutSavingHotkeyLabel}" />
                        <ctrl:HotkeyBox Grid.Row="5" Grid.Column="2" Hotkey="{Binding SettingsCopyWithoutSavingHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="6" Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnablePasteAndDeleteHotkey}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsPasteAndDeleteHotkeyLabel}" />
                        <ctrl:HotkeyBox Grid.Row="6" Grid.Column="2" Hotkey="{Binding SettingsPasteAndDeleteHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="7" Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnablePasteAndFavoriteHotkey}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsPasteAndFavoriteHotkeyLabel}" />
                        <ctrl:HotkeyBox Grid.Row="7" Grid.Column="2" Hotkey="{Binding SettingsPasteAndFavoriteHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="8" Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnablePasteAsPlainTextHotkey}" />
                        <TextBlock Grid.Row="8" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsPasteAsPlainTextHotkeyLabel}" />
                        <ctrl:HotkeyBox Grid.Row="8" Grid.Column="2" Hotkey="{Binding SettingsPasteAsPlainTextHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Custom hotkey actions (placed next to the other shortcut sections) -->
                <Expander Classes="settings-section">
                    <Expander.Header>
                        <TextBlock Text="Custom hotkey actions" FontSize="16" FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="10" Margin="8,10,0,0">
                        <TextBlock Classes="body-muted" TextWrapping="Wrap"
                                   Text="Bind a hotkey to a transformation of the most recent clip. Target format: 'builtin:UpperCase' for a built-in text transformation, 'script:MyScript' for a user script, 'ai:MyPreset' for an AI preset, 'prompt:Your fixed prompt' to send a one-off prompt to the AI service, or 'aiprompt:auto' (also: text, image-to-text, image-to-image) to open the AI prompt dialog. For 'aiprompt:', any text after a '|' is pre-filled into the prompt textbox, e.g. 'aiprompt:text|Translate to French:'. The 'Global' toggle decides whether the hotkey is captured system-wide or only when Clipthrough has focus." />
                        <Grid ColumnDefinitions="260,*" ColumnSpacing="12" MinHeight="200">
                            <DockPanel Grid.Column="0" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                    <Button Classes="secondary compact"
                                            Content="Add"
                                            Command="{Binding AddCustomHotkeyDraftCommand}" />
                                    <Button Classes="destructive compact"
                                            Content="Remove"
                                            Command="{Binding RemoveCustomHotkeyDraftCommand}"
                                            CommandParameter="{Binding SelectedCustomHotkeyDraft}" />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding SettingsCustomHotkeyDrafts}"
                                         SelectedItem="{Binding SelectedCustomHotkeyDraft, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Gesture}" FontFamily="Consolas,Cascadia Code,monospace" />
                                                <TextBlock Text="→" Classes="body-muted" />
                                                <TextBlock Text="{Binding Target}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <StackPanel Grid.Column="1" Spacing="6"
                                        DataContext="{Binding SelectedCustomHotkeyDraft}"
                                        IsEnabled="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Classes="detail-label" Text="Hotkey gesture (e.g. Ctrl+Alt+U)" />
                                <TextBox Text="{Binding Gesture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
                                <TextBlock Classes="detail-label" Text="Target (builtin:Name | script:Name | ai:Name | prompt:Text | aiprompt:Kind[|Prefill])" />
                                <TextBox FontFamily="Consolas,Cascadia Code,monospace"
                                         Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
                                <CheckBox Content="Global (capture system-wide; otherwise only when Clipthrough is focused)"
                                          IsChecked="{Binding IsGlobal, Mode=TwoWay}" />
                                <CheckBox Content="Paste after transforming (Ctrl+V into foreground window)"
                                          IsChecked="{Binding PasteAfter, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Storage -->
                <Expander Classes="settings-section" IsVisible="{Binding IsSettingsSectionStorageVisible}"
                          IsExpanded="{Binding IsSettingsSectionStorageExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <TextBlock Text="{Binding SettingsStorageTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="12" Margin="8,10,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="detail-label"
                                       Text="{Binding SettingsDatabasePathLabel}" />
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <TextBox Text="{Binding SettingsDatabasePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Classes="secondary compact"
                                        Command="{Binding BrowseDatabasePathCommand}"
                                        CommandParameter="{Binding $parent[Window]}"
                                        Content="{Binding SettingsBrowseDatabasePathButtonLabel}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="detail-label"
                                       Text="{Binding SettingsDatabasePasswordLabel}" />
                            <TextBox Text="{Binding SettingsDatabasePassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PasswordChar="*"
                                     RevealPassword="{Binding IsDatabasePasswordVisible}" />
                            <CheckBox Content="{Binding SettingsShowPasswordLabel}"
                                      IsChecked="{Binding IsDatabasePasswordVisible}" />
                            <TextBlock Classes="body-muted"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding SettingsDatabasePassword, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Text="{Binding SettingsDatabasePasswordWarningText}" />
                        </StackPanel>

                        <TextBlock Classes="body-muted"
                                   Text="{Binding SettingsStorageHintText}"
                                   TextWrapping="Wrap" />

                        <Border Classes="surface-panel" Padding="12" Margin="0,8,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding SettingsClipAngelImportTitle}" />
                                <TextBlock Classes="body-muted"
                                           Text="{Binding SettingsClipAngelImportDescription}"
                                           TextWrapping="Wrap" />
                                <Button Classes="secondary"
                                        HorizontalAlignment="Left"
                                        IsEnabled="{Binding IsClipAngelImportSupported}"
                                        Command="{Binding ImportClipAngelCommand}"
                                        CommandParameter="{Binding $parent[Window]}"
                                        Content="{Binding SettingsClipAngelImportButtonLabel}" />
                                <ProgressBar Minimum="0"
                                             Maximum="{Binding ClipAngelImportTotal}"
                                             Value="{Binding ClipAngelImportProcessed}"
                                             IsVisible="{Binding IsImportingClipAngel}"
                                             Height="6" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>

                <!-- Retention -->
                <Expander Classes="settings-section" IsVisible="{Binding IsSettingsSectionRetentionVisible}"
                          IsExpanded="{Binding IsSettingsSectionRetentionExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <TextBlock Text="{Binding SettingsRetentionTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                    </Expander.Header>
                    <Grid ColumnDefinitions="Auto,260,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="10"
                          Margin="8,10,0,0">
                        <CheckBox Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableNormalClipLifetime}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsNormalClipLifetimeLabel}" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding SettingsNormalClipLifetimeDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="1" Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableSensitiveClipLifetime}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsSensitiveClipLifetimeLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="2"
                                 Text="{Binding SettingsSensitiveClipLifetimeMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Expander>

                <!-- Capacity -->
                <Expander Classes="settings-section" IsVisible="{Binding IsSettingsSectionCapacityVisible}"
                          IsExpanded="{Binding IsSettingsSectionCapacityExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <TextBlock Text="{Binding SettingsCapacityTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                    </Expander.Header>
                    <Grid ColumnDefinitions="Auto,260,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="10"
                          Margin="8,10,0,0">
                        <CheckBox Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableMaxLibrarySize}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsMaxLibrarySizeLabel}" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding SettingsMaxLibrarySizeMegabytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="1" Content="{Binding SettingsEnableShortcutLabel}"
                                  IsChecked="{Binding SettingsEnableMaxEntryCount}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsMaxEntryCountLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="2"
                                 Text="{Binding SettingsMaxEntryCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SettingsClipLimitLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="2"
                                 Text="{Binding SettingsMaxClipSizeKilobytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Expander>

                <!-- Sensitivity rules -->
                <Expander Classes="settings-section" IsVisible="{Binding IsSettingsSectionSensitivityVisible}"
                          IsExpanded="{Binding IsSettingsSectionSensitivityExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <Grid ColumnDefinitions="*,Auto"
                              MinWidth="500">
                            <TextBlock Text="{Binding SettingsSensitivityTitle}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Classes="secondary compact"
                                    Command="{Binding AddSensitivityRuleCommand}"
                                    Content="{Binding SettingsAddRuleButtonLabel}" />
                        </Grid>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding SensitivityRules}"
                                  Margin="8,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SensitivityRuleEditorViewModel">
                                <Expander IsExpanded="{Binding IsExpanded}">
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                              ColumnSpacing="8">
                                            <TextBlock Text="{Binding HeaderText}" />
                                            <TextBlock Grid.Column="1"
                                                       Classes="body-muted"
                                                       Text="{Binding SummaryText}" />
                                            <Button Grid.Column="2"
                                                    Classes="destructive compact"
                                                    IsVisible="{Binding CanRemove}"
                                                    Command="{Binding RemoveCommand}"
                                                    Content="{Binding $parent[Window].DataContext.DeleteButtonLabel}" />
                                        </Grid>
                                    </Expander.Header>
                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="10"
                                          RowDefinitions="Auto,Auto,Auto">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="detail-label"
                                                       Text="{Binding $parent[Window].DataContext.SettingsRuleNameLabel}" />
                                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Classes="detail-label"
                                                       Text="{Binding $parent[Window].DataContext.SettingsRuleSeverityLabel}" />
                                            <ComboBox ItemsSource="{Binding $parent[Window].DataContext.SensitivitySeverityOptions}"
                                                      SelectedItem="{Binding Severity}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                                            <TextBlock Classes="detail-label"
                                                       Text="{Binding $parent[Window].DataContext.SettingsRulePatternLabel}" />
                                            <TextBox Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <CheckBox Grid.Row="2"
                                                  Content="{Binding $parent[Window].DataContext.SettingsRuleEnabledLabel}"
                                                  IsChecked="{Binding IsEnabled}" />
                                    </Grid>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- Tools -->
                <Expander Classes="settings-section" IsVisible="{Binding IsSettingsSectionToolsVisible}"
                          IsExpanded="{Binding IsSettingsSectionToolsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <TextBlock Text="{Binding SettingsToolsTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="12" Margin="8,10,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="detail-label"
                                       Text="{Binding SettingsExternalEditorPathLabel}" />
                            <TextBox Text="{Binding SettingsExternalEditorPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Classes="body-muted"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="Optional. Leave empty to open text and file clips with the OS default app or picker." />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Classes="detail-label"
                                       Text="{Binding SettingsExternalImageEditorPathLabel}" />
                            <TextBox Text="{Binding SettingsExternalImageEditorPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Classes="body-muted"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="Optional override for image clips. Leave empty to reuse the default editor path above, or fall back to the OS default if both are empty." />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Classes="detail-label"
                                       Text="{Binding SettingsExternalDiffToolPathLabel}" />
                            <TextBox Text="{Binding SettingsExternalDiffToolPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Classes="body-muted"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="Full path to a diff executable. Invoked as: tool.exe &quot;left-file&quot; &quot;right-file&quot;. Works with WinMerge, Beyond Compare, VS Code (use code --diff wrapper), Meld, KDiff3, etc." />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Expander Classes="settings-section"
                          IsVisible="{Binding IsSettingsSectionUserScriptsVisible}"
                          IsExpanded="{Binding IsSettingsSectionUserScriptsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <TextBlock Text="User scripts" FontSize="16" FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="10" Margin="8,10,0,0">
                        <TextBlock Classes="body-muted" TextWrapping="Wrap"
                                   Text="User scripts receive the clip text as 'input' (string) and must return a string. C# scripting syntax (Roslyn)." />
                        <Grid ColumnDefinitions="260,*" ColumnSpacing="12" MinHeight="260">
                            <DockPanel Grid.Column="0" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                    <Button Classes="secondary compact"
                                            Content="Add"
                                            Command="{Binding AddScriptDraftCommand}" />
                                    <Button Classes="destructive compact"
                                            Content="Remove"
                                            Command="{Binding RemoveScriptDraftCommand}"
                                            CommandParameter="{Binding SelectedScriptDraft}" />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding SettingsUserScriptDrafts}"
                                         SelectedItem="{Binding SelectedScriptDraft, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <StackPanel Grid.Column="1" Spacing="6"
                                        DataContext="{Binding SelectedScriptDraft}"
                                        IsEnabled="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Classes="detail-label" Text="Name" />
                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
                                <TextBlock Classes="detail-label" Text="Code (C#)" />
                                <ctrl:SyntaxTextEditor MinHeight="220"
                                                       SyntaxHint=".cs"
                                                       Text="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- AI transforms -->
                <Expander Classes="settings-section"
                          IsVisible="{Binding IsSettingsSectionAiVisible}"
                          IsExpanded="{Binding IsSettingsSectionAiExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <TextBlock Text="AI transforms"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="10" Margin="8,10,0,0">
                        <TextBlock Classes="body-muted"
                                   TextWrapping="Wrap"
                                   Text="Send text clips to an AI chat-completions endpoint and save the result as a new clip. Choose a provider below." />
                        <CheckBox Content="Enable AI transforms"
                                  IsChecked="{Binding SettingsEnableAi}" />
                        <StackPanel Spacing="6">
                            <TextBlock Classes="detail-label" Text="Provider" />
                            <ComboBox ItemsSource="{Binding AiProviderOptions}"
                                      SelectedItem="{Binding SettingsAiProvider, Mode=TwoWay}"
                                      MinWidth="180" />
                        </StackPanel>

                        <!-- OpenAI settings -->
                        <StackPanel Spacing="10" IsVisible="{Binding IsOpenAiSettingsVisible}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="detail-label" Text="Base URL (blank = https://api.openai.com/v1)" />
                                <TextBox PlaceholderText="https://api.openai.com/v1"
                                         Text="{Binding SettingsAiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="detail-label" Text="API key (blank = use OPENAI_API_KEY env var)" />
                                <TextBox PasswordChar="*"
                                         PlaceholderText="sk-…"
                                         Text="{Binding SettingsAiApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="detail-label" Text="Model (blank = gpt-4o-mini)" />
                                <TextBox PlaceholderText="gpt-4o-mini"
                                         Text="{Binding SettingsAiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="detail-label" Text="Image model (used for image→image presets; blank = gpt-image-1)" />
                                <TextBox PlaceholderText="gpt-image-1"
                                         Text="{Binding SettingsAiImageModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="detail-label" Text="Reasoning effort (only used by reasoning models; blank = off)" />
                                <ComboBox ItemsSource="{Binding AiReasoningEffortOptions}"
                                          SelectedItem="{Binding SettingsAiReasoningEffort, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Copilot settings -->
                        <StackPanel Spacing="10" IsVisible="{Binding IsCopilotSettingsVisible}">
                            <TextBlock Classes="body-muted" TextWrapping="Wrap"
                                       Text="Sign in with your GitHub account to use Copilot as the AI provider. Requires an active GitHub Copilot subscription." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="primary compact"
                                        Content="Sign in with GitHub"
                                        Command="{Binding CopilotSignInCommand}"
                                        IsVisible="{Binding !IsCopilotSignedIn}" />
                                <Button Classes="secondary compact"
                                        Content="Sign out"
                                        Command="{Binding CopilotSignOutCommand}"
                                        IsVisible="{Binding IsCopilotSignedIn}" />
                            </StackPanel>
                            <TextBlock Classes="body-muted" Text="{Binding CopilotSignInStatus}"
                                       IsVisible="{Binding CopilotSignInStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       TextWrapping="Wrap" />
                            <!--
                                When a device-flow code is active, surface it
                                in a big read-only textbox so the user can
                                select it manually if the auto-copy was
                                clobbered by another clipboard write, and
                                offer a one-click "Copy code" alongside.
                            -->
                            <StackPanel Spacing="6"
                                        IsVisible="{Binding HasCopilotUserCode}">
                                <TextBlock Classes="detail-label"
                                           Text="Your GitHub device code (copied to clipboard)" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Text="{Binding CopilotUserCode, Mode=OneWay}"
                                             IsReadOnly="True"
                                             FontFamily="Consolas, Menlo, monospace"
                                             FontSize="20"
                                             FontWeight="SemiBold"
                                             MinWidth="180"
                                             VerticalContentAlignment="Center"
                                             ToolTip.Tip="Select to copy manually, or use the Copy code button." />
                                    <Button Classes="secondary compact"
                                            Content="Copy code"
                                            Command="{Binding CopyCopilotUserCodeCommand}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="detail-label" Text="Model (blank = gpt-4o)" />
                                <TextBox PlaceholderText="gpt-4o"
                                         Text="{Binding SettingsAiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Semantic search -->
                <Expander Classes="settings-section"
                          IsVisible="{Binding IsSettingsSectionSemanticVisible}"
                          IsExpanded="{Binding IsSettingsSectionSemanticExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <TextBlock Text="Search" FontSize="16" FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="10" Margin="8,10,0,0">
                        <TextBlock Classes="body-muted" TextWrapping="Wrap"
                                   Text="Semantic search uses a small on-device embedding model (MiniLM-L6) to rank clips by meaning. Results from full-text and semantic search are fused with reciprocal rank fusion. Regex, wildcard, and whole-word modes disable semantic ranking." />
                        <CheckBox Content="Enable semantic search (on-device embedding model + fusion with full-text search)"
                                  IsChecked="{Binding SettingsEnableSemanticSearch, Mode=TwoWay}" />
                        <TextBlock Classes="body-muted" Text="{Binding SemanticCoverageText}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="secondary compact"
                                    Content="Refresh coverage"
                                    Command="{Binding RefreshSemanticCoverageCommand}" />
                            <Button Classes="secondary compact"
                                    Content="Re-embed all clips"
                                    ToolTip.Tip="Flag every clip for re-embedding. The worker will reprocess them in the background."
                                    Command="{Binding RerunAllEmbeddingsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- OCR -->
                <Expander Classes="settings-section"
                          IsVisible="{Binding IsSettingsSectionOcrVisible}"
                          IsExpanded="{Binding IsSettingsSectionOcrExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <TextBlock Text="OCR" FontSize="16" FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="10" Margin="8,10,0,0">
                        <TextBlock Classes="body-muted" TextWrapping="Wrap"
                                   Text="OCR uses the built-in Windows.Media.Ocr engine. Install extra language packs from Windows Settings → Time &amp; Language → Language → Add a language (with the optional OCR feature) to recognize more scripts, then list their BCP-47 tags below (e.g. 'en+he')." />
                        <CheckBox Content="Automatically run OCR on new image clips in the background"
                                  IsChecked="{Binding SettingsAutoOcrImageClips, Mode=TwoWay}" />
                        <StackPanel Spacing="6">
                            <TextBlock Classes="detail-label" Text="Languages (BCP-47 tags, separated by + , or space; blank = user profile)" />
                            <TextBox PlaceholderText="en+he"
                                     Text="{Binding SettingsOcrLanguages, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Remote API -->
                <Expander Classes="settings-section"
                          IsVisible="{Binding IsSettingsSectionRemoteApiVisible}"
                          IsExpanded="{Binding IsSettingsSectionRemoteApiExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <TextBlock Text="Remote API" FontSize="16" FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="10" Margin="8,10,0,0">
                        <TextBlock Classes="body-muted" TextWrapping="Wrap"
                                   Text="Exposes an authenticated HTTP API bound to 127.0.0.1 so local tools and AI agents can list, capture, delete, and transform clips. Requires a bearer token." />
                        <CheckBox Content="Enable local HTTP API"
                                  IsChecked="{Binding SettingsEnableRemoteApi, Mode=TwoWay}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Classes="detail-label" Text="Port (1–65535)" />
                                <NumericUpDown Minimum="1" Maximum="65535" Increment="1" Width="140"
                                               Value="{Binding SettingsRemoteApiPort, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Classes="detail-label" Text="Bind address" />
                                <TextBox PlaceholderText="127.0.0.1 (loopback only). Use 0.0.0.0 to expose on LAN."
                                         Text="{Binding SettingsRemoteApiBindAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="body-muted"
                                   FontSize="11"
                                   IsVisible="{Binding RemoteApiBindAddressIsNonLoopback}"
                                   TextWrapping="Wrap"
                                   Text="⚠ Non-loopback bind: the API will be reachable from other machines on your network. Use a strong token." />
                        <StackPanel Spacing="6">
                            <TextBlock Classes="detail-label" Text="Bearer token" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                <TextBox Grid.Column="0"
                                         PasswordChar="•"
                                         RevealPassword="{Binding IsRemoteApiTokenRevealed}"
                                         PlaceholderText="Paste or generate a token"
                                         AutomationProperties.Name="Remote API bearer token"
                                         Text="{Binding SettingsRemoteApiToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ToggleButton Grid.Column="1" Classes="secondary compact"
                                              IsChecked="{Binding IsRemoteApiTokenRevealed, Mode=TwoWay}"
                                              AutomationProperties.Name="Reveal bearer token"
                                              ToolTip.Tip="Reveal / hide token"
                                              Content="👁" />
                                <Button Grid.Column="2" Classes="secondary compact"
                                        Content="Generate"
                                        AutomationProperties.Name="Generate a random bearer token"
                                        Command="{Binding GenerateRemoteApiTokenCommand}" />
                                <Button Grid.Column="3" Classes="secondary compact"
                                        Content="Copy"
                                        AutomationProperties.Name="Copy bearer token to clipboard"
                                        Command="{Binding CopyRemoteApiTokenCommand}" />
                            </Grid>
                        </StackPanel>
                        <TextBlock Classes="body-muted" TextWrapping="Wrap"
                                   Text="Send requests with header: Authorization: Bearer &lt;token&gt;. Endpoints: GET /clips, GET /clips/{id}, POST /clips, DELETE /clips/{id}, POST /clips/{id}/transform." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="detail-label" VerticalAlignment="Center" Text="Docs:" />
                            <TextBox IsReadOnly="True" MinWidth="260"
                                     Text="{Binding RemoteApiDocsUrl, Mode=OneWay}"
                                     AutomationProperties.Name="Swagger UI URL" />
                            <Button Classes="secondary compact" Content="Copy"
                                    Command="{Binding CopyRemoteApiDocsUrlCommand}" />
                            <Button Classes="secondary compact" Content="Open"
                                    Command="{Binding OpenRemoteApiDocsUrlCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="detail-label" VerticalAlignment="Center" Text="Schema:" />
                            <TextBox IsReadOnly="True" MinWidth="260"
                                     Text="{Binding RemoteApiSchemaUrl, Mode=OneWay}"
                                     AutomationProperties.Name="OpenAPI schema URL" />
                            <Button Classes="secondary compact" Content="Copy"
                                    Command="{Binding CopyRemoteApiSchemaUrlCommand}" />
                            <Button Classes="secondary compact" Content="Open"
                                    Command="{Binding OpenRemoteApiSchemaUrlCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Updates -->
                <Expander Classes="settings-section"
                          IsVisible="{Binding IsSettingsSectionUpdatesVisible}"
                          IsExpanded="{Binding IsSettingsSectionUpdatesExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <TextBlock Text="Updates" FontSize="16" FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="10" Margin="8,10,0,0">
                        <TextBlock Classes="body-muted" TextWrapping="Wrap"
                                   Text="Clipthrough uses Velopack for auto-updates. When enabled, the app checks the feed URL on launch and downloads any newer build in the background. Updates are NEVER applied automatically while you're using Clipthrough — you'll be notified and can choose to restart now or install the next time you close the app. Only effective when installed via a Velopack package." />
                        <CheckBox Content="Check for updates on launch and download in the background"
                                  IsChecked="{Binding SettingsEnableAutoUpdate}" />
                        <CheckBox Content="Apply downloaded updates automatically on startup (legacy behavior — restarts the app silently)"
                                  IsChecked="{Binding SettingsAutoApplyUpdatesOnStartup}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="secondary compact"
                                    Content="Check for updates now"
                                    Command="{Binding CheckForUpdatesNowCommand}" />
                            <Button Classes="secondary compact"
                                    Content="Restart and install downloaded update"
                                    Command="{Binding RestartAndInstallUpdateCommand}" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Classes="detail-label" Text="Update feed URL (CLIPTHROUGH_UPDATE_FEED overrides this; blank uses the default GitHub Releases feed)" />
                            <TextBox PlaceholderText="https://github.com/owner/repo/releases/latest/download"
                                     Text="{Binding SettingsUpdateFeedUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="10"
                    HorizontalAlignment="Right">
            <Button Classes="secondary compact"
                    Click="OnCancelClick"
                    Content="{Binding SettingsCancelButtonLabel}" />
            <Button Classes="primary compact"
                    Click="OnSaveClick"
                    Content="{Binding SettingsSaveButtonLabel}" />
        </StackPanel>
    </Grid>
</Window>
