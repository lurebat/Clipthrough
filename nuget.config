<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <!--
      Vellum is not on nuget.org. The five packages are committed under
      external/vellum-packages so a clean clone and a CI runner restore exactly
      what a developer does, with no submodule and no vendored source tree.
    -->
    <add key="vellum-local" value="external/vellum-packages" />
  </packageSources>

  <!--
    This mapping is NOT optional, and it is not a supply-chain nicety.

    "Vellum.Core" on nuget.org is a *different, unrelated* package - a reserved
    placeholder for an envelope encryption library - and it publishes the same
    version numbers we use, including 0.2.0, targeting net10.0. So pinning a
    version does not protect us: without this mapping, restore can succeed
    against the wrong package and the first sign of trouble is a compile error
    naming a type that does not exist.

    packageSourceMapping is all-or-nothing: once any mapping exists, every
    package needs one, or restore fails with NU1100. Hence the "*" entries.

    Several keys are listed for "*" on purpose, because the default public feed
    is not named the same everywhere - a developer machine may reach nuget.org
    through a mirror, while a CI runner uses nuget.org directly. Keys that are
    absent or disabled in a given environment are ignored rather than fatal;
    that was verified, not assumed. Add your own key here if restore reports
    NU1100 for packages that are not Vellum.
  -->
  <packageSourceMapping>
    <packageSource key="vellum-local">
      <package pattern="Vellum.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="azure-default">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Microsoft Visual Studio Offline Packages">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
