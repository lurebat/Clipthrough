<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Vellum.Avalonia</RootNamespace>
    <Description>Avalonia rich text editor control built on the headless Vellum document model.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vellum.Core\Vellum.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The context menu's enabled state is real logic, and a headless test platform cannot open a
         popup to observe it through the UI. -->
    <InternalsVisibleTo Include="Vellum.Avalonia.Tests" />
  </ItemGroup>

</Project>
