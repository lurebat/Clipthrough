<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Vellum contributors</Authors>
    <Product>Vellum</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AsafMah/Vellum</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AsafMah/Vellum</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>avalonia;richtext;editor;wysiwyg;text</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Source link comes from the SDK, so debugging into a package needs no extra reference. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Only the shipping libraries are packed. Without this the test projects
    produce packages too, which is noise at best and published by accident at
    worst.

    GeneratePackageOnBuild is deliberately *not* set. It would put packing on
    the inner development loop, where it is pure cost, to catch metadata
    mistakes that CI already catches on every push: the `pack` job in ci.yml
    packs each change, so a missing Description or a broken README path fails
    there rather than at release time.
  -->
  <PropertyGroup Condition="!$(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)src'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
